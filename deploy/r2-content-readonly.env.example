# Copy to /etc/ournotes/r2-content-readonly.env with mode 0600. Create an
# R2 token scoped ONLY to otonote-public-content with read/list permissions.
# Never use the private-state writer token here. Do not commit real values.
R2_ACCOUNT_ID=replace-account-id
R2_ACCESS_KEY_ID=replace-access-key-id
R2_SECRET_ACCESS_KEY=replace-secret-access-key
R2_PUBLIC_BUCKET=otonote-public-content
