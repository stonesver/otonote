---
import {filterVisual} from '../lib/filter-visuals';
const optionVisual = (kind: string, value: string | number) => {
  const visual = filterVisual(kind, String(value));
  return {'data-icon': visual.icon, 'data-icon-only': visual.iconOnly ? 'true' : undefined, 'data-round': visual.round ? 'true' : undefined};
};
import TeamPlanningScenario from "./TeamPlanningScenario.astro";
import SelectionFilters from "./SelectionFilters.astro";
import "../styles/calculator-workflow.css";
import "../styles/score-visuals.css";
import CalculatorSongPicker from "./CalculatorSongPicker.astro";
import PresetPortfolio from "./PresetPortfolio.astro";
import CalculatorStrategyGuide from "./CalculatorStrategyGuide.astro";
import GekisouOpponentInputs from "./GekisouOpponentInputs.astro";
import FilterPanel from "./FilterPanel.astro";
import CalculatorAttributeFilter from "./CalculatorAttributeFilter.astro";
import "../styles/calculator-selection.css";
import {memberCards, supportCards, projections, skillFilters} from "../lib/inventory-catalog";
import {
  catalog,
  getAsset,
  getCardRarity,
  getCardAttribute
} from "../lib/catalog";
import { globalSystems } from "../lib/global-systems";
import { TEAM_RULE_SET } from "../lib/team-draft.mjs";
import {sharedTeamPresentation} from "../lib/shared-team-presentation.mjs";
import "../styles/task-workbench.css";
import "../styles/task-prototype-theme.css";
import formalRules from "../data/formal-scoring-rules.json";
import { scoringRulesAvailable } from "../lib/scoring-release-gate.mjs";
import ScoringUnavailable from "./ScoringUnavailable.astro";
import ScoringModelNotice from './ScoringModelNotice.astro';
import { bandItemDatabase } from "../lib/band-items";
import { activeReleaseContext } from "../lib/release-context";
import { getRuntimeUiLabels } from "../lib/runtime-ui-labels";
import "../styles/tools.css";
import "../styles/workbench-layout.css";
import "../styles/calculator-polish.css";

const rulesAvailable = scoringRulesAvailable(formalRules, catalog.release.id);

const vipRanks = globalSystems.sourceReleaseId === catalog.release.id
  ? globalSystems.vipRanks
  : [];
const runtimeUi = getRuntimeUiLabels(activeReleaseContext.locale);
const clientData = JSON.stringify({
  ...sharedTeamPresentation(),
  sourceReleaseId: catalog.release.id,
  formalRules,
  skillFilterFacets: skillFilters.facets,
  bands: catalog.bands.map(b=>({id:b.id,masterId:b.masterId,name:b.displayName})),
  filterCharacters: catalog.characters.map(c=>({id:c.id,name:c.displayName,bandId:c.bandId})),
  attributeVisuals: catalog.cardTaxonomy.attributes.map(a=>({code:a.code,name:a.names[catalog.release.locale],color:a.color,iconUrl:getAsset(a.iconAssetId)?.previewUrl??null})),
  charts: catalog.musicCharts.map((chart) => ({ id: chart.id, trackId: chart.trackId,
    difficulty: chart.difficulty, analysisDataUrl: chart.analysisDataUrl })),
  characters: catalog.characters.map((character) => ({ id: character.masterId, name: character.displayName })),
  instruments: bandItemDatabase.items.map((item) => ({ id: item.masterId, name: item.name })),
  memberCards,
  supportCards,
  projections,
  vipRanks,
  locale: runtimeUi.locale,
  labels: runtimeUi.teamDraft,
  tracks: catalog.musicTracks.map((track) => ({
    id: track.id,
    title: track.title,
    maxLevel: track.maxLevel, attributeCode:track.musicType
  }))
}).replaceAll("<", "\\u003c");
const rarities = catalog.cardTaxonomy.rarities.map((rarity) => rarity.code);
const attributes = [...new Set([...memberCards, ...supportCards].map((card) => card.attributeCode))]
  .sort((left, right) => left - right);
---

{rulesAvailable ? <team-draft-workbench class="team-workbench">
  <script is:inline type="application/json" data-team-draft-data set:html={clientData}></script>
  <section class="calculator-journey">
    <header class="journey-heading"><div><span>当前选择</span><p class="journey-context">先选歌，再选择卡片和这次想比较的条件。</p></div></header>
    <div class="journey-tasks" role="group" aria-label="选择配队任务"><button type="button" data-journey-task="automatic" aria-pressed="true">帮我配一队</button><button type="button" data-journey-task="saved" aria-pressed="false">比较队伍 / 换卡</button></div>
    <section class="journey-step" data-journey-step="0" id="journey-step-0">
  <section class="team-draft-settings" id="song-settings" aria-labelledby="team-settings-title">
    <header class="tool-panel-header">
      <div><h2 id="team-settings-title">选择歌曲与难度</h2></div>
    </header>
    <CalculatorSongPicker />
    <div class="team-context-controls">
      <label hidden>
        <span>歌曲</span>
        <select data-song-select>
          <option value="">暂不选择</option>
          {catalog.musicTracks.map((track) => <option value={track.id}>{track.title}</option>)}
        </select>
      </label>
      <label hidden>
        <span>难度</span>
        <select data-difficulty-select>
          <option value="">暂不选择</option>
          <option value="easy">EASY</option>
          <option value="normal">NORMAL</option>
          <option value="hard">HARD</option>
          <option value="expert">EXPERT</option>
        </select>
      </label>
    </div>
  </section>
    </section>
    <section class="journey-step" data-journey-step="1" id="journey-step-1">
      <h3>用哪些卡来配？</h3><p class="journey-intro">可以直接看参考队伍，也可以手选卡、使用卡库或比较培养后的搭配。</p>
<label hidden class="selection-filter-row"><span>使用哪些卡牌</span><select data-search-scope>
      <option value="selected">当前所选 5＋5 张卡</option>
      <option value="owned">已拥有卡库（填写实际养成）</option>
      <option value="theoretical">全部卡库（卡片满养成）</option>
    </select></label>
<TeamPlanningScenario part="cards" />
      <p class="calculator-scope-note" data-inventory-scope-note></p>
    <div class="calculator-links"><button type="button" data-open-team-workspace="teams">卡库与队伍</button><button type="button" data-save-current-team>存为队伍</button></div>
    <p data-team-workspace-status role="status"></p><div class="tool-team-strip" data-team-workspace-summary></div>
      <details class="journey-manual" hidden><summary>编辑当前五名成员和五张留影</summary>
  <div class="team-workbench-grid" id="team-editor">
    <section class="team-builder">
      <div
        class="team-slot-list"
        data-team-slots
        data-ui-entity
        aria-live="polite"
      ></div>
      <details class="workbench-growth"><summary>调整当前槽位的等级、突破与觉醒</summary><div class="team-context-controls" data-growth-controls></div></details>
    </section>

  </div>
        <details class="journey-card-picker"><summary>更换成员或留影</summary>
  <section class="team-card-picker" id="card-library" aria-labelledby="team-picker-title">
    <header class="tool-panel-header">
      <div><span>CARD LIBRARY</span><h2 id="team-picker-title">选择当前槽位卡牌</h2></div>
      <label class="selection-slot-control"><span>放入位置</span><select data-card-slot data-quick>{[0,1,2,3,4].map(i=><option value={i}>{i===2?"位置 3 · 队长":`位置 ${i+1}`}</option>)}</select><span data-active-slot-label hidden>01</span></label>
    </header>
    <div data-card-filter-controls>
      <div class="team-kind-switch" role="group" aria-label="卡牌类型">
        <button type="button" data-picker-kind="member" aria-pressed="true">成员卡</button>
        <button type="button" data-picker-kind="support" aria-pressed="false">留影</button>
      </div>
      <SelectionFilters title="筛选成员与留影">
      <label slot="search" class="selection-search">搜索卡片<input type="search" data-card-search placeholder="卡名、角色、乐队、技能名或 ID" /></label>
      <div slot="quick" class="selection-filter-rows">
      <div data-card-attributes><CalculatorAttributeFilter /></div>
      <div class="selection-quick-grid selection-filter-rows">
        <label class="selection-filter-row"><span>乐队</span><select data-card-band data-quick><option value="">全部乐队</option>{catalog.bands.map(b=><option value={b.id} {...optionVisual('band', b.id)}>{b.displayName}</option>)}</select></label>
        <label class="selection-filter-row"><span>角色</span><select data-card-character><option value="">全部角色</option>{catalog.characters.map(c=><option value={c.id} data-band={c.bandId}>{c.displayName}</option>)}</select></label>
        <label class="selection-filter-row"><span>稀有度</span><select data-card-rarity data-quick><option value="">全部稀有度</option>{rarities.map(r=><option value={r} {...optionVisual('rarity', r)}>{getCardRarity(r)?.label??r}</option>)}</select></label>
        <label class="selection-filter-row"><span>持有情况</span><select data-card-owned data-quick><option value="">全部卡片</option><option value="owned">已拥有</option><option value="missing">未录入</option></select></label>
</div></div>
      <div class="selection-filter-grid selection-filter-rows"><label class="selection-filter-row"><span>激奏类型</span><select data-card-mission><option value="">全部类型</option>{['combo','luck','just'].map(m=><option value={m}>{m.toUpperCase()}</option>)}</select></label>
        <label class="selection-filter-row"><span>技能效果</span><select data-card-effect><option value="">全部激奏效果</option>{skillFilters.facets.find(f=>f.name==='gekisou-effect')?.options.map(o=><option value={o.value}>{o.label}</option>)}</select></label>
        <label class="selection-filter-row"><span>普通技能</span><select data-card-normal><option value="">全部普通技能</option><option value="simple">纯加分</option><option value="life">血量条件加分</option><option value="judgement">判定条件加分</option><option value="score">分卡 / 延时</option><option value="judge">判定辅助</option><option value="heal">生命回复</option></select></label>
        <label class="selection-filter-row"><span>排序</span><select data-card-sort><option value="rarity">稀有度优先</option><option value="newest">卡片编号从新到旧</option><option value="name">名称</option></select></label>
      </div>
      <span slot="results" data-card-count data-filter-count role="status"></span><button slot="results" type="button" data-card-reset data-filter-reset>重置筛选</button>
      </SelectionFilters>
    </div>
    <div class="card-picker-workspace">
      <div><div class="team-picker-results" data-card-results></div>
        <p class="team-filter-empty" data-card-empty hidden>没有符合条件的卡片。可重置筛选，或取消“已拥有”限制。</p>
        <div class="selection-pagination"><button type="button" data-card-prev>上一页</button><span data-card-page></span><button type="button" data-card-next>下一页</button></div>
      </div>
      <aside class="card-preview" aria-label="卡片技能预览"><div data-card-preview></div><p data-card-placement role="status"></p><button type="button" data-card-apply disabled>先选择一张卡</button><button type="button" class="team-clear-card" data-clear-card>清空当前位置的成员</button></aside>
    </div>
  </section>

        </details>
      </details>
  <details id="power-settings" class="production-power-panel workbench-breakdown"><summary>账号加成：乐器、角色评级与 TGW</summary>
    <div class="journey-account">
      {vipRanks.length > 0 && <label data-account-tgw>
        <span>T.G.W CARD 等级</span>
        <select data-tgw-rank-select>
          <option value="">尚未填写</option>
          {vipRanks.map((rank) =>
            <option value={rank.rank}>等级 {rank.rank}</option>
          )}
        </select>
      </label>}
      {vipRanks.length > 0 && <p data-tgw-bonus-note>
        T.G.W CARD 按正式包中的基点倍率逐槽位计算并逐维取整。
      </p>}
    </div>
    <details><summary>乐器 / 乐队道具等级（0 表示未启用）</summary>
      <div class="team-context-controls" data-instrument-controls></div>
    </details>
    <details><summary>全角色评级（影响全角色评级加成）</summary>
      <div class="team-context-controls" data-character-rank-controls></div>
    </details>
  </details>
    </section>
    <section class="journey-step" data-journey-step="2" id="journey-step-2">
      <h3>这次想打普通，还是激奏？</h3><p class="journey-intro">选好模式后，按参考发挥比较；也可以看看理想发挥或练习时的差别。</p>
<label hidden class="selection-filter-row"><span>演出模式</span><select data-pairing-mode><option value="ordinary">自由演出 · 普通</option><option value="gekisou">激奏演出</option></select></label><div class="journey-choices" role="group" aria-label="选择演出模式" data-choices="pairing-mode">
<button type="button" data-choice="ordinary" aria-pressed="false"><strong>普通自由演出</strong><span>比较综合力、加分技能和留影延时。</span></button>
<button type="button" data-choice="gekisou" aria-pressed="false"><strong>激奏演出</strong><span>加上 COMBO / LUCK / JUST 三段任务与奖励。</span></button>
</div>
    <TeamPlanningScenario part="performance" />
    <p class="calculator-scope-note" data-gekisou-rank-note hidden>尚未填写对手时，按指定名次比较（初始为三段第一），不代表实战能拿第一。可在下方调整。</p>
    <details class="calculator-extra" data-gekisou-settings hidden><summary>调整激奏条件 <span>名次、对手与抽样</span></summary><div class="calculator-extra-body">
      <p>发挥按上面的选择计算。未填对手时使用指定名次；增加任务计数能否抢到更高名次，需要结合对手判断。LUCK 使用抽样。</p>
      <label hidden>旧版判定偏差（毫秒）<input data-gekisou-offset type="number" min="-50" max="50" step="1" value="0" /></label>
      {[1, 2, 3].map(i => <label>第 {i} 段名次 <select data-gekisou-rank>{[1, 2, 3, 4, 5].map(rank => <option value={rank}>{rank}</option>)}</select></label>)}
    <GekisouOpponentInputs />
      <label>抽样批数（每批 120 次）<input data-gekisou-batches type="number" min="1" max="32" step="1" value="1" /></label>
      <label>随机种子 <input data-gekisou-seed type="number" min="0" max="4294967295" step="1" value="20260927" /></label>
      <label>模拟帧率 <select data-gekisou-fps><option value="60">60 FPS</option><option value="120">120 FPS</option></select></label>
      <p>建议用平均分搜索，再增加批数或更换种子复算接近的候选。样本最高分不等于理论最高分。</p>
    </div></details>
      <p class="journey-intro">推荐会保留有实际区别的搭配；如果几种方向得到同一队，就合并显示。</p>
      <details class="journey-advanced"><summary>限定乐队、属性或调整目标（可选）</summary>
<label hidden class="selection-filter-row"><span>推荐方式</span><select data-search-effort disabled><option value="practical" selected>实用推荐</option></select></label>      <p class="calculator-scope-note" data-search-effort-note></p><p class="calculator-scope-note" data-search-space></p>
<label class="selection-filter-row"><span>优化目标</span><select data-pairing-objective>
      <option value="expected_song_score">歌曲平均分（默认，估算）</option>
      <option value="minimum_song_score">最低分（激奏为样本最低）</option>
      <option value="maximum_song_score">最高分（激奏为样本最高）</option>
      <option value="formation_power">综合能力</option>
    </select></label>    <div data-search-filters><FilterPanel title="限定乐队、属性（可选）"><div class="optimizer-filter-fields selection-filter-rows">
    <label hidden class="selection-filter-row"><span>旧版计算组数</span><input type="number" min="1" max="100000" value="20" data-search-budget disabled /></label>
    <label class="selection-filter-row"><span>成员乐队</span><select data-search-band data-inline-filter data-filter-kind="band"><option value="">不限</option>{catalog.bands.map(band => <option value={band.masterId}>{band.displayName}</option>)}</select></label>
    <label class="selection-filter-row"><span>成员属性</span><select data-search-attribute data-inline-filter data-filter-kind="attribute"><option value="">不限</option>{attributes.map(attribute => <option value={attribute}>{getCardAttribute(attribute)?.names[catalog.release.locale] ?? attribute}</option>)}</select></label>
    <label class="selection-filter-row"><span>留影属性</span><select data-search-support-attribute data-inline-filter data-filter-kind="attribute"><option value="">不限</option>{attributes.map(attribute => <option value={attribute}>{getCardAttribute(attribute)?.names[catalog.release.locale] ?? attribute}</option>)}</select></label>
    </div></FilterPanel></div>
    <label class="selection-filter-row"><span>最多带几张扩窗成员卡</span><select data-planning-window-limit>{[5,0,1,2,3,4].map(n=><option value={n}>{n===5?'不限':`${n} 张`}</option>)}</select></label>
    <label class="selection-filter-row"><span>培养范围比较上限</span><input type="number" data-planning-variant-limit min="1" max="1000" value="24" /></label>
    <p class="calculator-scope-note">这是本次推荐的搜索设置，不是游戏限制。培养组合较多时，可以先指定愿意练的卡。</p>
    <details class="optimizer-advanced"><summary>保留当前队伍中的卡或配对</summary>
      <p>在下方编辑队伍后，可指定哪些卡一定要带、哪些卡不参加推荐。</p>
      <div class="planning-card-list" data-planning-card-locks></div>
    </details>
    <details class="optimizer-advanced"><summary>更多卡片约束（JSON）</summary>
      <p>JSON 可设置 bandId、attribute、supportAttribute、leaderId、requiredMemberIds、requiredSupportIds、excludedMemberIds、excludedSupportIds、lockedPairs。卡片 ID 支持数字。固定配对示例：&#123;"lockedPairs":[&#123;"memberCardId":1,"supportCardId":1&#125;]&#125;。</p>
      <label>搜索约束 <textarea data-search-constraints rows="4">&#123;&#125;</textarea></label>
    </details>
      </details>
    <div class="calculator-start">
    <div><p data-calculator-guidance aria-live="polite"></p></div>
    <div class="optimizer-actions"><button type="button" data-optimize-pairing>开始寻找配队</button>
    <button type="button" data-cancel-pairing disabled>停止本次推荐</button>
    <button type="button" data-resume-pairing hidden disabled>继续搜索</button>
    <button type="button" data-export-pairing disabled>导出计算结果</button>
    </div>
    </div>
    </section>
    <section class="journey-step" data-journey-step="3" id="journey-step-3">
      <p class="journey-results-tip">先比较推荐分数和成员／留影搭配，再应用队伍；需要核对时打开计分明细。结果为参考估算，尚未完成当前游戏版本的实战核验。</p>
  <section class="optimizer-results-panel" id="optimizer-results" aria-labelledby="optimizer-results-title">
    <header class="tool-panel-header"><div><span>比较这首歌的出分</span><h2 id="optimizer-results-title">推荐编成</h2></div><span class="calculator-search-state" data-search-state>等待开始</span></header>
    <p class="calculator-progress" data-pairing-progress aria-live="polite">计算时可以停止；修改卡片或条件后，需要重新比较。</p>
    <div class="calculator-empty" data-results-empty><div class="calculator-empty-slots" aria-hidden="true">{[1,2,3,4,5].map(i=><span class:list={[i===3&&'is-leader']}>{i===3?'队长':i}</span>)}</div><h3>选好歌曲，就可以开始配队。</h3><p>还没录入卡库也没关系，可以先看参考队伍。结果会说明使用了哪些卡、按什么养成计算。</p></div>
    <ol data-practical-progress class="practical-progress" aria-label="实用推荐进度" hidden></ol>
    <p data-practical-summary hidden></p>
    <ol data-pairing-results></ol>
    <details class="calculator-notes"><summary>搜索详情与计算条件</summary><p data-search-diagnostics></p><p>待排查分支是尚未排除的组合分组，搜索过程中还会继续拆分，不代表剩余队伍数量或完成百分比。</p><p data-search-limits></p></details>
  </section>

      <details class="journey-help"><summary>配队攻略与计算说明</summary>
        <CalculatorStrategyGuide ruleVersion={formalRules.ruleSetVersion} />
  <details class="tool-capability workbench-rules"><summary>计算规则与默认养成</summary>
    <div>
      <span class="tool-status tool-status--experimental">正式包代码复算</span>
      <p>选择 5 张成员卡与 5 张留影，设置成长、角色评级、乐器和 T.G.W CARD，按正式包规则逐槽位计算综合能力。</p>
    </div>
    <dl>
      <div><dt>规则版本</dt><dd>{formalRules.ruleSetVersion}</dd></div>
      <div><dt>编成位置</dt><dd>{TEAM_RULE_SET.officialSlotCount} 组</dd></div>
      <div><dt>核验方式</dt><dd>代码与 Master</dd></div>
    </dl>
    <p id="team-capability-title" class="tool-boundary">
      第三槽为队长。未填写时按未突破、未觉醒的当前等级上限计算；角色评级与 T.G.W 默认为 1，乐器与回忆默认为 0。不含活动能力加成。
    </p>
  </details>

        <ScoringModelNotice />
      </details>
    </section>
    <section class="journey-saved" hidden><PresetPortfolio /></section>
  </section>
  <noscript><p class="tool-noscript">编成研究台需要 JavaScript 才能编辑；卡牌与来源资料仍可从卡牌目录浏览。</p></noscript>
</team-draft-workbench> : <ScoringUnavailable />}

<script>
  import "../lib/team-draft-workbench.mjs";
</script>
