---
import SiteAnalytics from "./SiteAnalytics.astro";
import { getUi } from "../lib/ui-i18n";
import { SITE_CONTACT } from "../lib/site-contact.mjs";
import "../styles/site-footer.css";

interface Props {
  title: string;
  locale: string;
  href: (path: string) => string;
}
const { title, locale, href } = Astro.props;
const en = locale === "en";
const ui = getUi(locale);
---
<footer class="site-footer archive-footer" id="site-footer">
  <div class="archive-footer__description"><p>{ui.siteNotice}</p><small>© {new Date().getFullYear()} {title} · {ui.siteRights}</small></div>
  <address class="archive-footer__contact" aria-label={en ? "Contact & feedback" : "联系与反馈"}>
    <a href={href("/about/")}>{en ? "About" : "网站说明"}</a>
    <a href={`mailto:${SITE_CONTACT.email}`}>{en ? "Contact" : "联系"}</a>
    {SITE_CONTACT.repositoryUrl && <a href={SITE_CONTACT.repositoryUrl} target="_blank" rel="noopener noreferrer">{en ? "Feedback" : "问题反馈"}</a>}
  </address>
  <SiteAnalytics locale={locale} />
</footer>
