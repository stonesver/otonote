---
import { gallery } from '../lib/gallery';
import { activeReleaseContext } from '../lib/release-context';
import { siteHref } from '../lib/site-context';
const en = activeReleaseContext.locale === 'en';
const href = (path: string) => import.meta.env.BASE_URL === '/' ? path : siteHref(path, activeReleaseContext);
const profileBackground = gallery.backgrounds.find(image => image.id === 4 && image.thumbnail)
  ?? gallery.backgrounds.find(image => image.thumbnail);
const entries = [
  { kind: 'comics', title: en ? 'Comics' : '漫画', text: en ? 'Everyday stories from the bands' : '查看角色日常漫画', count: gallery.comics.length, previews: gallery.comics.filter(image => image.thumbnail).slice(0, 2), unit: en ? 'comics' : '篇漫画' },
  { kind: 'stamps', title: en ? 'Stamps' : '表情', text: en ? 'Browse & download character stamps' : '浏览与下载角色表情', count: gallery.stamps.length, previews: gallery.stamps.filter(image => image.thumbnail).slice(0, 3), unit: en ? 'stamps' : '张表情' },
  { kind: 'profile-decorations', title: en ? 'Profile decorations' : '名片装饰', text: en ? 'Profile stickers & backgrounds' : '个人名片的贴纸与背景', count: gallery.stickers.length + gallery.backgrounds.length, previews: [...(profileBackground ? [profileBackground] : []), ...gallery.stickers.filter(image => image.thumbnail).slice(0, 2)], unit: en ? 'decorations' : '件装饰' }
];
---
<section class="home-gallery" aria-labelledby="home-gallery-heading">
  <header><h2 id="home-gallery-heading">{en ? 'Image galleries' : '图片图集'}</h2></header>
  <nav class="gallery-entrypoints" aria-label={en ? 'Image galleries' : '图片图集'}>
    {entries.filter(entry => entry.count).map(entry => <a class={`gallery-entry gallery-entry--${entry.kind}`} href={href(`/${entry.kind}/`)}>
      <div class="gallery-entry-art" aria-hidden="true">{entry.previews.map(image => <img class={`gallery-preview--${image.mediaType}`} src={href(image.thumbnail!)} alt="" width="140" height="120" loading="lazy" />)}</div>
      <div class="gallery-entry-copy"><h3>{entry.title}</h3><p>{entry.text}</p><span class="gallery-entry-count"><b>{entry.count}</b> {entry.unit}</span></div>
    </a>)}
  </nav>
</section>
<style>
  .home-gallery { margin:26px 0 16px; }
  .home-gallery > header { display:flex; align-items:baseline; gap:12px; margin-bottom:12px; }
  .home-gallery > header h2 { font-size:17px; margin:0; letter-spacing:-.02em; }
  .home-gallery > header > span { font-size:11px; color:var(--theme-muted); }
  .gallery-entrypoints { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  .gallery-entry { position:relative; isolation:isolate; display:flex; flex-direction:column; min-width:0; min-height:206px; padding:20px; overflow:hidden; border:1px solid var(--line); border-radius:14px; transition:border-color 160ms ease,transform 160ms ease; }
  .gallery-entry:hover { border-color:var(--lacquer); transform:translateY(-3px); }
  .gallery-entry--comics { background:color-mix(in srgb, var(--theme-warning) 8%, var(--theme-surface)); }
  .gallery-entry--stamps { background:color-mix(in srgb, var(--theme-secondary) 10%, var(--theme-surface)); }
  .gallery-entry--profile-decorations { background:color-mix(in srgb, var(--theme-accent) 7%, var(--theme-surface)); }
  .gallery-entry-copy { position:relative; z-index:1; margin-top:83px; }
  .gallery-entry h3 { margin:0 0 3px; font:700 21px var(--font-body); letter-spacing:-.025em; }
  .gallery-entry p { margin:0; color:var(--theme-text-soft); font-size:11px; }
  .gallery-entry-count { display:block; margin-top:13px; color:var(--theme-muted); font-size:10px; }
  .gallery-entry-count b { color:var(--lacquer); font:12px var(--font-mono); margin-right:3px; }
  .gallery-entry-art { position:absolute; right:20px; top:12px; width:calc(100% - 40px); height:96px; }
  .gallery-entry-art img { position:absolute; width:90px; height:90px; object-fit:contain; transition:transform 200ms ease; }
  .gallery-entry--comics .gallery-entry-art img { right:26px; top:3px; width:83px; height:100px; object-fit:cover; object-position:top; background:var(--paper-light); padding:4px; box-shadow:0 3px 10px color-mix(in srgb, var(--theme-shadow-color) 12.55%, transparent); transform:rotate(-9deg); }
  .gallery-entry--comics .gallery-entry-art img + img { right:86px; top:2px; transform:rotate(6deg); z-index:-1; }
  .gallery-entry--comics:hover .gallery-entry-art img:first-child { transform:rotate(-4deg) translateY(-3px); }
  .gallery-entry--stamps .gallery-entry-art img:first-child { right:94px; top:4px; transform:rotate(-12deg); }
  .gallery-entry--stamps .gallery-entry-art img:nth-child(2) { right:45px; top:-4px; width:100px; height:100px; transform:rotate(6deg); }
  .gallery-entry--stamps .gallery-entry-art img:nth-child(3) { right:-6px; top:15px; transform:rotate(13deg); }
  .gallery-entry--stamps:hover .gallery-entry-art img:nth-child(2) { transform:rotate(0) translateY(-4px); }
  .gallery-entry-art .gallery-preview--backgrounds { width:165px; height:85px; right:15px; top:2px; object-fit:cover; border:4px solid var(--theme-surface); border-radius:7px; box-shadow:0 4px 12px color-mix(in srgb, var(--theme-shadow-color) 14.12%, transparent); transform:rotate(-6deg); }
  .gallery-entry-art .gallery-preview--stickers { width:70px; height:60px; right:0; top:43px; transform:rotate(8deg); filter:drop-shadow(0 2px 2px color-mix(in srgb, var(--theme-shadow-color) 12.55%, transparent)); }
  .gallery-entry-art .gallery-preview--stickers:last-child { right:118px; top:8px; width:55px; height:45px; transform:rotate(-12deg); }
  @media(max-width:950px) and (min-width:651px) {
    .gallery-entry { padding:16px; }
    .gallery-entry h3 { font-size:18px; }
    .gallery-entry p { max-width:155px; }
    .gallery-entry-art { right:10px; width:calc(100% - 20px); }
  }
  @media(max-width:650px) {
    .home-gallery > header { gap:8px; }
    .home-gallery > header h2 { font-size:16px; }
    .home-gallery > header > span { font-size:10px; }
    .gallery-entrypoints { grid-template-columns:1fr; gap:10px; }
    .gallery-entry { min-height:133px; padding:18px; }
    .gallery-entry-copy { margin-top:0; max-width:60%; }
    .gallery-entry h3 { font-size:20px; }
    .gallery-entry p { max-width:145px; }
    .gallery-entry-count { margin-top:12px; }
    .gallery-entry-art { width:135px; right:8px; top:17px; }
    .gallery-entry--comics .gallery-entry-art img { width:66px; height:86px; right:8px; }
    .gallery-entry--comics .gallery-entry-art img + img { right:54px; }
    .gallery-entry--stamps .gallery-entry-art img { width:65px; height:65px; }
    .gallery-entry--stamps .gallery-entry-art img:first-child { right:70px; top:12px; }
    .gallery-entry--stamps .gallery-entry-art img:nth-child(2) { width:75px; height:75px; right:32px; top:4px; }
    .gallery-entry--stamps .gallery-entry-art img:nth-child(3) { right:-5px; top:25px; }
    .gallery-entry-art .gallery-preview--backgrounds { width:120px; height:65px; right:5px; top:9px; }
    .gallery-entry-art .gallery-preview--stickers { width:55px; height:45px; top:47px; }
    .gallery-entry-art .gallery-preview--stickers:last-child { width:42px; height:36px; right:84px; top:5px; }
  }
  @media(prefers-reduced-motion:reduce) { .gallery-entry,.gallery-entry-art img { transition:none; } .gallery-entry:hover { transform:none; } }
</style>
