---
import EventTypeBadge from "./EventTypeBadge.astro";
import Countdown from "./EventCountdown.astro";
import EventIdentity from "./EventIdentity.astro";
import EventIcon from "./EventIcon.astro";
import type { EventArchiveData, EventIdentity as Identity, EventCard } from "../lib/event-archive";
import { eventCopy } from "../lib/event-copy";
import "../styles/event-archive.css";
import "../styles/event-editorial.css";
interface Props { identities?: Record<number, Identity>; cards?: Record<number, EventCard[]>; archive: EventArchiveData; locale?: string; href?: (path: string) => string; artworks?: Record<number, { cover?: string; logo?: string }>; story?: boolean; readableCounts?: Record<number, number> }
const { identities = {}, cards = {}, archive, locale = "zh-CN", href = (path: string) => path, artworks = {}, story = false, readableCounts = {} } = Astro.props;
const copy = eventCopy(locale);
const records = [...(archive.records ?? [])].filter(event => !story || event.story.episodes.length).sort((a,b) => (b.schedule.startAt ?? "").localeCompare(a.schedule.startAt ?? "") || b.id - a.id);
---
<div class="event-archive content-shell ef-directory" data-event-directory>

  {records.length > 0 ? <>
    <div class="ea-toolbar"><p><strong data-event-count>{records.length}</strong> {copy.events}</p><label class="ea-search"><EventIcon name="search" size={18} /><span class="visually-hidden">{copy.search}</span><input type="search" data-event-search placeholder={copy.search} /></label></div>
    <div class:list={["ea-cards", {"ea-cards--single": records.length === 1}]}>{records.map(event => {
      const art = artworks[event.id];
      return <article class="ea-card" data-event-card data-search={[event.name, ...((identities[event.id]?.bands ?? []).map(band => band.name)), ...((identities[event.id]?.characters ?? []).map(character => character.name))].join(" ")}>
        <a class="ea-card-link" href={href(story ? `/stories/events/${event.id}/` : `/events/${event.id}/`)}>
          <div class:list={["ea-card-art", { "ea-card-art--empty": !art?.cover }]}>
            {art?.cover ? <img class="ea-card-cover" src={art.cover} alt="" loading="lazy" width="1920" height="1440" /> : <span class="ea-card-placeholder" aria-hidden="true">{story ? "STORY" : "EVENT"}<small>{String(event.id).padStart(2, "0")}</small></span>}
            {art?.logo && <img class="ea-card-logo" src={art.logo} alt="" width="460" height="240" loading="lazy" />}
            <span class="ea-card-badge">{story ? copy.stories : copy.event}</span>
          </div>
          <div class="ea-card-body"><p class="ea-card-eyebrow"><EventTypeBadge mode={event.mode} locale={locale} /> {event.edition === "jp" ? copy.jp : copy.global} · EVENT {String(event.id).padStart(2,"0")}</p><h2 lang={event.nameLocale ?? undefined}>{event.name}</h2><p class="ea-card-dates">{event.schedule.startAt?.slice(0,10) ?? "—"} — {event.schedule.endAt?.slice(0,10) ?? "—"}</p>
            <EventIdentity identity={identities[event.id]} compact locale={locale} /><div class="ea-card-facts"><span><EventIcon name="book" size={14} /><b>{event.story.episodes.length}</b> {copy.episodes}</span>{story ? <span><b>{readableCounts[event.id] ?? 0}</b> {copy.available}</span> : <><span><EventIcon name="music" size={14} /><b>{event.challengeSongs.length}</b> {copy.songs}</span><span><EventIcon name="card" size={14} /><b>{cards[event.id]?.length ?? event.pickupCards.length}</b> {locale === "en" ? "cards" : "活动卡牌"}</span></>}</div>
            <div class="ea-card-footer"><Countdown start={event.schedule.startAt} end={event.schedule.endAt} edition={event.edition} timeZone={event.schedule.timeZone} locale={locale} /><span>{story ? copy.chapters : copy.details}</span></div>
          </div>
        </a>
      </article>;
    })}</div>
    <div class="ea-empty" data-event-empty hidden><h2>{copy.noResults}</h2><button type="button" class="ea-button" data-event-clear>{copy.clear}</button></div>
  </> : <section class="ea-empty"><span class="ea-empty-symbol" aria-hidden="true">{story ? "≡" : "◇"}</span><h2>{story ? copy.noStories : copy.noEvents}</h2><p>{story ? copy.emptyStories : copy.empty}</p>{story && <a class="ea-button" href={href("/stories/main/")}>{copy.allStories} →</a>}</section>}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-event-directory]").forEach(root => {
    const input = root.querySelector<HTMLInputElement>("[data-event-search]");
    if (!input) return;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-event-card]")];
    const update = () => {
      const query = input.value.trim().toLocaleLowerCase();
      cards.forEach(card => card.hidden = !(card.dataset.search ?? "").toLocaleLowerCase().includes(query));
      const count = cards.filter(card => !card.hidden).length;
      root.querySelector("[data-event-count]")!.textContent = String(count);
      root.querySelector<HTMLElement>("[data-event-empty]")!.hidden = count > 0;
      const url = new URL(location.href); query ? url.searchParams.set("q", input.value) : url.searchParams.delete("q");
      history.replaceState(null, "", url);
    };
    const restore = () => { input.value = new URLSearchParams(location.search).get("q") ?? ""; update(); };
    input.addEventListener("input", update);
    root.querySelector("[data-event-clear]")?.addEventListener("click", () => { input.value = ""; update(); input.focus(); });
    window.addEventListener("popstate", restore);
    restore();
  });
</script>
