---
import EditionBadge from "../../components/EditionBadge.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceDisclosure from '../../components/SourceDisclosure.astro';
import catalog from '../../lib/shared-immersive';
import { activeReleaseContext } from '../../lib/release-context';
import { siteHref } from '../../lib/site-context';
import '../../styles/immersive.css';
const en = activeReleaseContext.locale === 'en';
const say = (zh: string, english: string) => en ? english : zh;
const href = (path: string) => import.meta.env.BASE_URL === '/' ? path : siteHref(path, activeReleaseContext);
const playable = catalog.scenes.filter(s => s.assetRoot && Reflect.get(s, 'cameraVerified') === true).length;
---
<BaseLayout title={say('沉浸式场景', 'Immersive scenes')} description={say(`浏览 ${catalog.bands.length} 支乐队的 ${catalog.scenes.length} 个日常情景，保存游戏原图。`, `Explore ${catalog.scenes.length} scenes from ${catalog.bands.length} bands and save original game images.`)}>
  <div class="content-shell immersive-library">
    <header class="immersive-heading"><div><p class="home-kicker">MOMENTS WITH THE BANDS</p><h1>{say('在她们的日常里，停留片刻。', 'A moment in their everyday lives.')}</h1><p>{say(`${catalog.scenes.length} 个情景 · ${catalog.backgroundCount} 套背景 · ${catalog.bands.length} 支乐队 · ${playable} 个可播放`, `${catalog.scenes.length} scenes · ${catalog.backgroundCount} backgrounds · ${catalog.bands.length} bands · ${playable} playable`)}</p></div><a href={href('/?home=immersive')}>{say('首页融合预览', 'Homepage preview')} ↗</a></header>
    <p class="immersive-catalog-note">{say('游戏原图可查看和保存。动态镜头还在校准；验证前不会展示近似画面或提供近似动画下载。', 'View and save the original game images. Animation cameras are under review; approximate renders and downloads are paused until verified.')}</p>
    <div class="immersive-filters"><label>{say('乐队', 'Band')}<select data-scene-band><option value="all">{say('全部乐队', 'All bands')}</option>{catalog.bands.map(b => <option value={b.id}>{en ? b.nameEn : b.name}</option>)}</select></label><label><input type="checkbox" data-scene-available />{say('只看已校准动态', 'Verified animations only')}</label><span data-scene-count aria-live="polite">{catalog.scenes.length} / {catalog.scenes.length}</span></div>
    <div class="immersive-catalog-grid">{[...catalog.scenes].sort((a,b) => Number(!!b.assetRoot)-Number(!!a.assetRoot) || String(a.id).localeCompare(String(b.id),'en',{numeric:true})).map(scene => { const Card = scene.assetRoot ? 'a' : 'div'; return <article class="immersive-card" data-scene-band-id={scene.bandId} data-scene-available={String(Reflect.get(scene, 'cameraVerified') === true)}>
      <Card class="immersive-card-link" href={scene.assetRoot ? (scene.sourceHref ?? href(`/immersive/${scene.id}/`)) : undefined} aria-label={scene.assetRoot ? (en ? scene.nameEn : scene.name) : undefined}>
      <div class="immersive-card-art">{scene.poster && <img src={href(scene.poster)} alt={en ? scene.nameEn : scene.name} loading="lazy" width="512" height="288" />}{scene.assetRoot && <span>{Reflect.get(scene, 'cameraVerified') === true ? say('可播放 · 可导出', 'Play & export') : say('原图可下载', 'Original image available')}</span>}</div>
      <div class="immersive-card-copy"><small>{en ? catalog.bands.find(b => b.id === scene.bandId)?.nameEn : catalog.bands.find(b => b.id === scene.bandId)?.name}</small><h2>{en ? scene.nameEn : scene.name}</h2><EditionBadge record={scene}/>{!scene.assetRoot && <p>{say('动态素材尚未缓存', 'Animation assets not cached')}</p>}</div>
      </Card>
    </article>})}</div>
    <SourceDisclosure><p>{say('情景原图来自已收录的游戏内容。动态还原需要逐场景核对相机和人物位置，未验证前仅展示原图。', 'Original scene images come from collected game content. Animation reconstruction requires per-scene camera and character checks; only original images appear until verified.')}</p></SourceDisclosure>
  </div>
</BaseLayout>
<script>
  const band = document.querySelector<HTMLSelectElement>('[data-scene-band]')!;
  const available = document.querySelector<HTMLInputElement>('input[data-scene-available]')!;
  function filter() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-scene-band-id]').forEach(card => {
      card.hidden = !(band.value === 'all' || card.dataset.sceneBandId === band.value) || (available.checked && card.dataset.sceneAvailable !== 'true');
      if (!card.hidden) count++;
    });
    document.querySelector('[data-scene-count]')!.textContent = `${count} / ${document.querySelectorAll('[data-scene-band-id]').length}`;
  }
  band.addEventListener('change', filter); available.addEventListener('change', filter);
</script>
