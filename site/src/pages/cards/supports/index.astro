---
import CatalogBrowser from "../../../components/CatalogBrowser.astro";
import SupportCardTile from "../../../components/SupportCardTile.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { catalog, getAsset, getCardAttribute } from "../../../lib/shared-catalog";
import { filterVisualOptions } from "../../../lib/filter-visuals";
import { cardDetailProjections, publicSkills } from "../../../lib/support-card-list-data";
import { sharedCardFilters } from "../../../lib/shared-card-filters";

const skillFilters = await sharedCardFilters("support", cardDetailProjections.supportCards, publicSkills);

const rarityOptions = filterVisualOptions.rarity;
const attributeOptions = [
  ...new Set(catalog.supportCards.map((card) => card.attributeCode))
]
  .sort((left, right) => left - right)
  .map((value) => ({ value: String(value), label: getCardAttribute(value)?.names[catalog.release.locale] ?? `属性 ${value}`, icon: getAsset(getCardAttribute(value)?.iconAssetId)?.previewUrl }));
const characterOptions = catalog.characters.map((character) => ({
  value: character.id,
  label: character.displayName
}));
const bandOptions = catalog.bands.map((band) => ({
  value: band.id,
  label: band.displayName,
  icon: getAsset(band.logoAssetId)?.previewUrl
}));
const facets = [
  { name: "character", label: "登场角色", options: characterOptions },
  { name: "band", label: "关联乐队", options: bandOptions },
  { name: "rarity", label: "稀有度", options: rarityOptions },
  { name: "attribute", label: "属性", options: attributeOptions },
  ...skillFilters.facets
];
---

<BaseLayout title="留影">

  <section class="catalog-section card-directory-section">
    <div class="content-shell">
      <CatalogBrowser
        count={catalog.supportCards.length}
        noun="张留影"
        placeholder="搜索留影标题、登场角色或 Master ID…"
        facets={facets}
      >
        <div class="catalog-grid support-card-grid card-catalog-grid">
          {catalog.supportCards.map((card) => <SupportCardTile card={card} skillFacets={skillFilters.records.get(card.id)} />)}
        </div>
      </CatalogBrowser>
    </div>
  </section>
</BaseLayout>
