---
import '../styles/tool-ux.css';
import '../styles/skill-activation.css';
import ToolGlyph from './ToolGlyph.astro';
import { activeReleaseContext } from '../lib/release-context';
import { siteHref } from '../lib/site-context';
interface Props { title: string; description: string; meta?: string; directory?: boolean; kind?: string; }
const {title,description,meta,directory=false,kind}=Astro.props;
const href=import.meta.env.BASE_URL==='/'?'/tools/':siteHref('/tools/',activeReleaseContext);
---
<header class="tool-page-header" data-copy-layer="primary">
  <div class="content-shell tool-page-header-inner">
    <div class="tool-page-heading">
      {!directory && <a class="tool-page-back" href={href}>游戏工具 <span aria-hidden="true">/</span></a>}
      <h1>{kind && <span class="tool-title-glyph" aria-hidden="true"><ToolGlyph kind={kind} /></span>}{title}</h1>
      <p>{description}</p>
    </div>
    {meta && <span class="tool-page-meta">{meta}</span>}
  </div>
</header>
<style>
  .tool-page-header { padding:18px 0 16px; color:var(--ink); background:var(--paper); }
  .tool-page-header-inner { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .tool-page-heading { min-width:0; }
  .tool-page-back { display:inline-flex; gap:10px; margin-bottom:4px; font:600 11px var(--font-body); color:var(--lacquer); }
  .tool-page-back span { color:var(--silver); }
  .tool-page-back:hover { text-decoration:underline; }
  h1 { margin:0; font:700 clamp(24px,3vw,29px)/1.4 var(--font-display); letter-spacing:.01em; }
  p { margin:9px 0 0; max-width:68ch; color:var(--silver-dark); font:13px/1.8 var(--font-body); }
  .tool-page-meta { flex-shrink:0; padding:8px 12px; border:1px solid var(--line); border-radius:8px; color:var(--lacquer); font:12px var(--font-body); }
  @media(max-width:650px) { .tool-page-header { padding:20px 0 16px; }.tool-page-header-inner { align-items:start; gap:12px; flex-direction:column; }.tool-page-meta { display:none; } }
</style>
