---
import {activeReleaseContext} from '../lib/release-context';
import {filterVisualOptions} from '../lib/filter-visuals';
import {catalog,getAsset,type MemberCard,type SupportCard} from '../lib/catalog';
import itemIndexData from '@projection-data/database-shards/items-index.json';
import {validateArtifact} from '../lib/artifact-contracts';
import type {ItemIndexRecord} from '../lib/game-database';
import '../styles/arena.css';
import '../styles/tool-design-system.css';
const {handoff=false}=Astro.props;
const en=activeReleaseContext.locale==='en';
const itemIndex=validateArtifact<{schemaVersion:number;records:ItemIndexRecord[]}>('database-shards/items-index.json',itemIndexData,{schemaVersion:1,fields:{contentReleaseId:'string',records:'array','records[]':'object','records[].id':'string'}}).records;
const cardImage=(id:string|null)=>{const asset=getAsset(id);return asset?.thumbnailUrl||asset?.previewUrl||null;};
const cardVisual=(c:MemberCard|SupportCard)=>({id:String(c.masterId),name:c.displayName,image:cardImage(c.thumbnailAssetId),href:c.id,attribute:c.attributeCode});
const visuals=JSON.stringify({band:filterVisualOptions.band.map(b=>({...b,color:catalog.bands.find(v=>String(v.masterId)===b.value)?.mainColor})),attribute:filterVisualOptions.attribute,
 items:itemIndex.map(i=>({id:String(i.masterId),icon:getAsset(i.iconAssetId)?.previewUrl??null})),
 members:catalog.memberCards.map(cardVisual),supports:catalog.supportCards.map(cardVisual),
 songs:catalog.musicTracks.map(s=>({id:String(s.masterId),title:s.title,attribute:s.musicType,missions:s.gekisouMissions.map(m=>m.typeCode),image:getAsset(s.jacketAssetId)?.previewUrl??null,bandIds:s.bandIds.map(id=>String(catalog.bands.find(b=>b.id===id)?.masterId??id))}))}).replaceAll('<','\\u003c');
---
<section class="arena tool-design-tokens content-shell" data-arena-root data-handoff={String(handoff)} data-locale={activeReleaseContext.locale} aria-busy="true">
 <header class="arena-heading"><div><h1 tabindex="-1">{handoff?(en?'Arena team entry':'舞台配队'):(en?'Gekisou Arena':'激奏舞台')}</h1></div><div class="arena-actions"><button data-action="refresh">{en?'Check updates':'刷新资料'}</button><button data-action="copy-link" disabled>{en?'Copy link':'复制页面链接'}</button></div></header>
 <p class="arena-meta" data-arena-meta></p>
 <p class="arena-feedback" data-arena-feedback role="status" aria-live="polite"></p>
 <div data-arena-body><div class="arena-loading" role="status"><p>{en?'Loading stage conditions…':'正在读取舞台条件…'}</p><div class="arena-segments" aria-hidden="true"><span></span><span></span><span></span></div></div></div>
 <dialog class="arena-trend-dialog" data-arena-dialog aria-labelledby="arena-dialog-trends-title"><div class="arena-dialog-bar"><strong>{en?'Trend details':'趋势详情'}</strong><button type="button" data-action="dialog-close" aria-label={en?'Close trend details':'关闭趋势详情'}>{en?'Close':'关闭'} ×</button></div><div data-arena-dialog-body></div></dialog>
 <dialog class="arena-trend-dialog arena-reference-dialog" data-arena-reference-dialog aria-labelledby="arena-reference-title"><div class="arena-dialog-bar"><h2 id="arena-reference-title" data-arena-reference-title></h2><button type="button" data-action="reference-close" aria-label={en?'Close information':'关闭说明'}>{en?'Close':'关闭'} ×</button></div><div data-arena-reference-body></div></dialog>
 <dialog class="arena-trend-dialog arena-personal-dialog" data-arena-personal-dialog aria-labelledby="arena-personal-title"><div class="arena-dialog-bar"><h2 id="arena-personal-title">{en?'My arena rank':'我的舞台排名'}</h2><button type="button" data-personal-close>{en?'Close':'关闭'} ×</button></div><div data-arena-personal-body></div></dialog>
 <noscript>{en?'Enable JavaScript to query conditions. Teams are locked after song selection; arena calculation is not available.':'启用 JavaScript 后可查询舞台条件。抽歌后锁队，舞台计算尚未开放。'}</noscript>
 <script type="application/json" data-arena-visuals set:html={visuals}></script>
</section>
<script>import {installArenaPage} from '../lib/arena-ui.mjs';
 for(const root of document.querySelectorAll('[data-arena-root]')) installArenaPage(root);
</script>
