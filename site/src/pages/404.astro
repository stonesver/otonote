---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout contentHeading title="页面不存在" tone="ink">
  <section class="state-page">
    <div class="state-page-inner">
      <span class="state-code">ARCHIVE ERROR / 404</span>
      <h1>这份档案<br />尚未入库</h1>
      <p>地址可能来自旧版本。资源鉴赏、剧情阅读与场景编辑暂时关闭；角色、卡牌、歌曲资料和工具仍可使用。</p>
      <div class="hero-actions">
        <a class="button-primary" href="/">返回首页</a>
        <a class="button-secondary" href="/catalog/">查询角色与卡牌</a>
      </div>
    </div>
  </section>
</BaseLayout>
