---
interface Props { kind: string; }
const {kind}=Astro.props;
---
<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
 {kind==='gacha-history' && <><path d="M7 7h26v8a5 5 0 0 0 0 10v8H7v-8a5 5 0 0 0 0-10V7Z"/><path d="m20 11 2.5 5 5.5.8-4 4 .9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-4 5.5-.8L20 11ZM12 30h16"/></>}
 {kind==='deck-builder' && <><rect x="5" y="10" width="15" height="23" rx="3" transform="rotate(-12 5 10)"/><rect x="19" y="6" width="15" height="23" rx="3" transform="rotate(10 19 6)"/><path d="M12 17v8m-4-4h8M25 13l1.4 3 3.3.4-2.4 2.3.6 3.3-2.9-1.5-2.9 1.5.6-3.3-2.4-2.3 3.3-.4z"/></>}
 {kind==='song-calculator' && <><path d="M7 29V18m8 11V10m8 19V21m8 8V6M5 34h30"/><path d="m6 12 8-7 9 9 9-12" opacity=".45"/></>}
 {kind==='song-ranking' && <><path d="M5 33V22h9v11m0 0V11h11v22m0 0V18h10v15M4 33h32"/><path d="m16 6 3-3 3 3"/></>}
 {kind==='ap-grade' && <><circle cx="20" cy="20" r="14"/><path d="m13 20 5 5 10-11M20 2v4m0 28v4M2 20h4m28 0h4"/></>}
 {kind==='event-efficiency' && <><path d="M22 3c2 9-5 11-5 17 0 3 2 5 4 5 4 0 7-4 6-9 7 7 8 17-1 21C10 42 3 27 9 18c0 5 2 7 5 7-4-10 7-12 8-22Z"/></>}
 {kind==='live2d' && <><path d="M13 5H6v8m21-8h7v8M6 27v8h7m21-8v8h-7"/><circle cx="20" cy="16" r="6"/><path d="M10 31c1-10 19-10 20 0"/></>}
 {kind==='chart-preview' && <><path d="M13 5h14l9 30H4L13 5Zm7 0v30M9 20h22M6 29h28"/><rect x="14" y="12" width="6" height="3" rx="1"/><rect x="23" y="23" width="8" height="3" rx="1"/></>}
 {kind==='story-reader' && <><path d="M20 9C14 4 7 5 4 7v25c5-2 11-1 16 3 5-4 11-5 16-3V7c-3-2-10-3-16 2Zm0 0v26M9 13l6 2m-6 4 6 2m10-6 6-2m-6 8 6-2"/></>}
</svg>
