[Unit]
Description=OurNotes private update health and recovery log
Requires=docker.service
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ournotes/r2-prerender.env
EnvironmentFile=/etc/ournotes/r2-content-readonly.env
EnvironmentFile=-/etc/ournotes/cloudflare-analytics.env
ExecStart=/usr/local/libexec/ournotes/run-update-health.sh
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
