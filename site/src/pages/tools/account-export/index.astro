---
import ToolPageHeader from "../../../components/ToolPageHeader.astro";
import BaseLayout from '../../../layouts/BaseLayout.astro';
const links=[{label:'查看 GitHub 源码',url:import.meta.env.PUBLIC_GROWTH_SOURCE_URL || 'https://github.com/stonesver/ournotes-growth-exporter'},
  {label:'前往 GitHub 下载预览版',url:import.meta.env.PUBLIC_GROWTH_DOWNLOAD_URL || 'https://github.com/stonesver/ournotes-growth-exporter/releases'}]
  .filter(link=>typeof link.url==='string'&&/^https:\/\//.test(link.url));
---
<BaseLayout title="养成导入与本地工具">
  <ToolPageHeader title="养成导入与本地工具" description="导出角色卡、留影、乐器、角色评级与 TGW，用于配卡计算。" meta="港澳台 / EN / 韩服 · BHK 邮箱密码" />
  <section class="content-shell growth-tool-guide">
    <div class="growth-tool-links">{links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>
    <ol>
      <li>下载并解压。Windows 打开 <code>Start.cmd</code>，Mac 打开 <code>Start.command</code>，无需另配登录参数。</li>
      <li>在本机页面输入邮箱、密码，读取后下载养成 JSON。</li>
      <li>回到配卡工具「我的卡库 · 从游戏导入我的养成」，选择 JSON，预览后应用。</li>
    </ol>
    <p>本地工具的密码不经过本站，JSON 仅在浏览器解析。也可直接网页登录：密码会经本站服务器处理，不保存密码或令牌。</p>
    <p>非官方工具，存在账号限制风险；登录可能使游戏会话失效，遇到额外验证会停止。导入后请核对数据，回忆加成需自行设置。</p>
    <p>支持 Windows x64、Mac Apple Silicon。Mac 版尚未完成 Apple 公证，不支持 Intel Mac。用完后关闭工具终端即可退出。</p>
  </section>
</BaseLayout>

<style>
.growth-tool-guide { padding-bottom:40px; }.growth-tool-guide p { max-width:78ch; font-size:14px; line-height:1.9; }.growth-tool-guide a { color:var(--lacquer); text-decoration:underline; }
.growth-tool-guide ol { max-width:78ch; padding-left:1.5em; font-size:14px; line-height:1.9; }.growth-tool-guide li { padding:4px 0; }
.growth-tool-links { display:flex; flex-wrap:wrap; gap:12px; margin:20px 0 12px; }.growth-tool-links a { display:inline-flex; align-items:center; min-height:44px; padding:8px 14px; border:1px solid var(--lacquer); border-radius:8px; font-size:14px; text-decoration:none; }.growth-tool-links a:focus-visible { outline:2px solid var(--lacquer); outline-offset:3px; }
</style>
