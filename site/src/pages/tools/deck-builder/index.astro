---
import "../../../styles/tool-studio.css";
import ToolPageHeader from "../../../components/ToolPageHeader.astro";
import TeamDraftWorkbench from "../../../components/TeamDraftWorkbench.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="卡组配队">
<div class="tool-studio" data-tool-kind="deck-builder">
  <ToolPageHeader kind="deck-builder" title="卡组配队" description="选一首歌，看看参考队伍，或按自己的卡片和养成比较搭配。" meta="选歌 → 选卡范围 → 演出条件 → 推荐" />
  <section class="catalog-section tool-workbench-section">
    <div class="content-shell">
      <TeamDraftWorkbench />
    </div>
  </section>
</div>
</BaseLayout>
