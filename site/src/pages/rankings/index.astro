---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {GAME_SERVERS, currentServerContext} from '../../lib/game-servers.mjs';
import {activeReleaseContext} from '../../lib/release-context';
import {catalog, getAsset} from '../../lib/catalog';
import {gameModeDatabase} from '../../lib/game-modes';
import {validatedEvents} from '../../lib/event-content.mjs';
import {siteHref} from '../../lib/site-context';
import '../../styles/edition-context.css';
import '../../styles/player-rankings.css';
const en=activeReleaseContext.locale==='en';
const context=currentServerContext();
const cards = (kind: 'member' | 'support') => Object.fromEntries((kind === 'member' ? catalog.memberCards : catalog.supportCards).map(card => {
  const asset=getAsset(card.thumbnailAssetId);
  return [String(card.masterId), {name:card.displayName, image:asset?.thumbnailUrl || asset?.previewUrl || null,
    href:siteHref(`/cards/${kind === 'member' ? 'members' : 'supports'}/${card.id}/`,activeReleaseContext)}];
}));
const image = (id: string | null | undefined) => {const asset=getAsset(id);return asset?.thumbnailUrl || asset?.previewUrl || null;};
const eventData = JSON.stringify({region:activeReleaseContext.region,
  events:validatedEvents(gameModeDatabase.events,activeReleaseContext).map(event=>({id:String(event.id),name:event.name,
    edition:event.edition,...event.schedule,rankingConfigured:event.ranking?.configured,
    bandIds:[...new Set([event.story.bandId,...event.effects.map(effect=>effect.constraints.bandId)].filter(Boolean))].map(String),
    attributes:[...new Set(event.effects.map(effect=>effect.constraints.cardType).filter(Boolean))]})),
  bands:catalog.bands.map(band=>({id:String(band.masterId),name:band.displayName,image:image(band.logoAssetId)})),
  attributes:catalog.cardTaxonomy.attributes.map(attribute=>({id:String(attribute.code),name:attribute.names[en?'en':'zh-CN'],image:image(attribute.iconAssetId)})),
  songs:catalog.musicTracks.map(track=>({id:String(track.masterId),name:track.title,image:image(track.jacketAssetId)}))
}).replaceAll('<','\\u003c');
const cardData=JSON.stringify({region:activeReleaseContext.region,member:cards('member'),support:cards('support')}).replaceAll('<','\\u003c');
---
<BaseLayout title={en?'Player rankings':'玩家排行榜'}>
  <div class="content-shell player-rankings" data-player-rankings data-locale={activeReleaseContext.locale}>
    <script is:inline type="application/json" data-rank-cards set:html={cardData}></script>
    <script is:inline type="application/json" data-rank-context set:html={eventData}></script>
    <header class="pr-page-heading"><div><div class="eyebrow">PLAYER RANKINGS</div><h1>{en?'Player rankings':'玩家排行榜'}</h1><p>{en?'See the scores. Explore the teams behind them.':'看成绩，也看高分背后的编成。'}</p></div><span class="pr-update-note">{en?'Updated about every 10 minutes':'约每 10 分钟更新'}</span></header>
    <nav class="page-editions" aria-label={en?'Game server':'游戏区服'}><div>{GAME_SERVERS.map(server=><a data-ranking-server={server.id} href={`/${server.region}/${activeReleaseContext.locale}/rankings/?server=${server.id}&view=page`} aria-current={context.serverId===server.id?'page':undefined}>{en?server.englishLabel:server.label}</a>)}</div></nav>
    <section class="pr-board" aria-label={en?'Ranking board':'榜单'}>
      <div class="pr-filters">
        <div><label for="rank-band">{en?'Band':'乐队'}</label><select id="rank-band" data-rank-band><option value="">{en?'All bands':'全部乐队'}</option></select></div>
        <div class="pr-event-filter"><label for="rank-event">{en?'Event':'活动'}</label><select id="rank-event" data-rank-event><option value="">{en?'No events yet':'暂无活动数据'}</option></select></div>
        <div><label for="rank-board">{en?'Board':'榜单'}</label><select id="rank-board" data-rank-board><option value="auto">{en?'Available board':'已接入榜单'}</option><option value="event-points">{en?'Event points':'活动积分榜'}</option><option value="music">{en?'Song':'单曲榜'}</option><option value="total-music">{en?'Total score':'总分榜'}</option></select></div>
        <div hidden data-rank-song-label><label for="rank-song">{en?'Song':'歌曲'}</label><select id="rank-song" data-rank-song></select></div>
      </div>
      <div class="pr-current-board"><span data-rank-cover hidden></span><div class="pr-board-title"><div class="pr-event-line"><span data-rank-event-name></span><span class="pr-event-state" data-rank-event-state hidden></span><span class="pr-bonuses" data-rank-bonuses></span></div><h2 data-rank-song-name>{en?'Choose a server to begin':'选择区服查看榜单'}</h2></div><button class="pr-refresh" type="button" data-rank-refresh><span aria-hidden="true">↻</span>{en?'Refresh':'刷新'}</button></div>
      <div class="pr-meta"><p data-rank-status role="status">{en?'Choose a server to view its rankings.':'选择区服，查看对应榜单。'}</p><time data-rank-time></time><span data-rank-count></span></div>
      <div class="pr-column-labels" aria-hidden="true"><span>{en?'Rank':'名次'}</span><span>{en?'Player':'玩家'}</span><span data-rank-team-label>{en?'High-score team':'最高分队伍'}</span><span>{en?'Team power':'综合力'}</span><span data-rank-score-label>{en?'Score':'成绩'}</span><span></span></div>
      <ol class="pr-rows" data-rank-rows aria-label={en?'Player rankings':'玩家排名'}></ol>
      <div class="pr-empty" data-rank-empty hidden><span aria-hidden="true">—</span><p>{en?'There are no results for this board yet. Try another song or server.':'这个榜单暂时没有排名记录，可以切换歌曲或区服查看。'}</p></div>
      <div class="pr-load-sentinel" data-rank-sentinel><span data-rank-load-note></span></div>
      <div class="pr-pagination"><button type="button" data-rank-next hidden>{en?'Load 50 more':'再看 50 名'}</button><button type="button" data-rank-retry hidden>{en?'Try again':'重新加载'}</button></div>
      <p class="pr-footnote" data-rank-footnote>{en?'Teams and power are saved with the highest score. Captured results may cover only part of the ranking.':'队伍与综合力为最高分成绩对应的游戏记录。当前采集结果可能仅覆盖部分排名。'}</p>
    </section>
  </div>
</BaseLayout>
<script>import '../../lib/player-rankings-ui.mjs';</script>
