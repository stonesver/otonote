---
import SourceDisclosure from "../../components/SourceDisclosure.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalog } from "../../lib/shared-catalog";
import { activeReleaseContext } from "../../lib/release-context";
import { siteHref } from "../../lib/site-context";
import "../../styles/faceted-browser.css";

const localizedHref = (logicalPath: string) =>
  import.meta.env.BASE_URL === "/"
    ? logicalPath
    : siteHref(logicalPath, activeReleaseContext);
---

<BaseLayout title="卡牌资料">
  <section class="cards-entry" data-copy-layer="primary">
    <div class="content-shell cards-entry-shell">

      <nav class="card-kind-switchboard" aria-label="选择卡牌资料类型">
        <a class="card-kind-entry card-kind-entry--member" href={localizedHref("/cards/members/")} data-card-purpose="formation">
          <small>MEMBER CARDS · {catalog.memberCards.length}</small>
          <h2>成员卡用于乐队编成</h2>
          <p>角色 · 乐队 · 稀有度 · 属性</p>
          <span>查看成员卡 →</span>
        </a>
        <a class="card-kind-entry card-kind-entry--support" href={localizedHref("/cards/supports/")} data-card-purpose="equipment">
          <small>SNAPS · {catalog.supportCards.length}</small>
          <h2>留影用于装备</h2>
          <p>登场关系 · 稀有度 · 属性</p>
          <span>查看留影 →</span>
        </a>
      </nav>

      <SourceDisclosure>
        <p>卡牌图片、技能与养成资料来自游戏。留影画面中的登场角色不代表装备限制，搭配时请查看技能说明。</p>
      </SourceDisclosure>
    </div>
  </section>
</BaseLayout>
