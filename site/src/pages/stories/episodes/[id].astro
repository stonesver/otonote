---
import {storyLibrary as sharedStories} from "../../../lib/shared-stories";
import EditionBadge from "../../../components/EditionBadge.astro";
import {editionLabel} from "../../../lib/edition-library.mjs";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { storyLibrary, storyEntries, storyCharacters, storyCopy as copy, readTextStory, episodeLabel, storyKind, storyKindLabel } from "../../../lib/story-library";
import { activeReleaseContext } from "../../../lib/release-context";
import { siteHref } from "../../../lib/site-context";
import "../../../styles/story-text.css";
import { catalog, getAsset } from "../../../lib/catalog";
import { resolveStorySpeaker, storyAvatar, storyCharacter } from "../../../lib/story-avatars";
import { getStoryShareCopy } from "../../../lib/story-share-copy";
import { storyLineSpeakers } from "../../../lib/story-reader-search.mjs";
import { formatStoryLineText, groupStoryBlocks } from "../../../lib/story-text-format.mjs";
import "../../../styles/story-share.css";
export function getStaticPaths() { return storyLibrary.entries.map(entry => ({ params: { id: entry.id } })); }
const entry = storyEntries.get(Astro.params.id!)!;
const libraryEntry = sharedStories.entries.find(row=>row.id===entry.id);
const lines = readTextStory(entry.id);
const href = (path: string) => import.meta.env.BASE_URL === "/" ? path : siteHref(path, activeReleaseContext);
const previous = entry.previousId ? storyEntries.get(entry.previousId) : undefined;
const next = entry.nextId ? storyEntries.get(entry.nextId) : undefined;
const group = storyLibrary.entries.filter(other => other.group === entry.group);
const kind = storyKind(entry);
const band = catalog.bands.find(band => band.masterId === entry.bandIds[0]);
const logo = getAsset(band?.logoAssetId);
const names = entry.characterIds.map(id => storyCharacters.get(id)).filter(Boolean).join(" / ");
const shareCopy = getStoryShareCopy(activeReleaseContext.locale);
const en = activeReleaseContext.locale === 'en';
const speakers = [...new Set(lines.flatMap(line => storyLineSpeakers(line.speaker)))];
const subtitleLine = entry.category === "friendship" ? names : entry.chapterName;

const preparedLines = lines.map((line, index) => {
  const character = resolveStorySpeaker(line.speaker);
  const avatar = storyAvatar(character);
  const isMessageLike = Boolean(line.speaker) && line.kind !== "location" && line.kind !== "narration" && line.kind !== "subtitle";
  const pairAvatars = isMessageLike && !avatar
    ? storyLineSpeakers(line.speaker)
        .map(part => storyAvatar(resolveStorySpeaker(part)))
        .filter((item): item is NonNullable<typeof item> => Boolean(item))
        .slice(0, 2)
    : [];
  const fallbackLocales = line.fallbackLocales?.length ? line.fallbackLocales : line.locale ? [line.locale] : [];
  const fallbackLabel = fallbackLocales.length ? `${en ? 'Original' : '原文'}: ${fallbackLocales.join(' / ')}` : null;
  const formattedText = line.kind === "stamp" ? shareCopy.stampLabel : formatStoryLineText(line.text, line.kind);
  return {
    ...line,
    index,
    character,
    avatar,
    pairAvatars,
    fallbackLabel,
    formattedText,
  };
});

const blocks = groupStoryBlocks(preparedLines);
---
<BaseLayout contentHeading title={entry.title} description={`${storyKindLabel(kind)} · ${entry.title}`} navigationPath={entry.eventId != null ? '/stories/events/' : `/stories/${kind}/`}>
  <div class="st-reader-backdrop" style={`--band-accent:${band?.mainColor || "var(--theme-accent)"}`}>
    <article class="st-reader" id="story-top" data-text-reader data-kind={kind} data-story-id={entry.id} data-share-copy={JSON.stringify(shareCopy)}>
      <div class="st-reading-paper">
        <header class="st-reader-header" data-reader-header>
          <div class="st-reader-navrow">
            <div class="st-reader-crumbs">
              <a class="st-back" href={href(entry.eventId != null ? `/stories/events/#event-${entry.eventId}` : `/stories/${kind}/`)}>
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg>
                <span>{copy.back}</span>
              </a>
              <span class="st-crumb-sep" aria-hidden="true">/</span>
              <div class="st-reader-kicker">
                <span class="st-tag" data-kind={kind}>{storyKindLabel(kind)}</span>
                <span class="st-episode-label">{episodeLabel(entry)}</span>
                {subtitleLine && <span class="st-reader-subtitle">{subtitleLine}{entry.category === "viewpoint" && names ? ` · ${names}` : ""}</span>}
                <EditionBadge record={libraryEntry} />
                {libraryEntry?.editionPresence?.different && libraryEntry.editionPresence.counterparts?.map(target => (
                  <a class="st-edition-link" href={target.href}>{en ? 'Read in ' : '阅读'}{editionLabel(target.edition, en)} →</a>
                ))}
              </div>
            </div>
            {logo && (
              <img class="st-reader-logo" src={logo.previewUrl} alt={band?.displayName} width="76" height="30" />
            )}
          </div>

          <div class="st-reader-headline">
            <div class="st-reader-title">
              <h1>{entry.title || episodeLabel(entry)}</h1>
              {entry.description && <p class="st-reader-deck">{entry.description}</p>}
            </div>
            <div class="st-reader-meta">
              {entry.characterIds.length > 0 && (
                <div class="st-reader-cast" aria-label={copy.cast}>{entry.characterIds.slice(0, 6).map(id => {
                  const character = storyCharacter(id); const avatar = storyAvatar(character);
                  const charName = storyCharacters.get(id);
                  return <span class="st-cast-avatar" title={charName}>
                    {avatar ? <img src={avatar.thumbnailUrl || avatar.previewUrl} alt={charName || ""} width="24" height="24" /> : <b>{character?.shortName?.slice(0, 1) || charName?.slice(0, 1)}</b>}
                  </span>;
                })}</div>
              )}
              <span class="st-meta-count">{entry.lineCount} {copy.lines}</span>
              {entry.friendshipLevel > 0 && <span class="st-meta-count">{copy.bondLevel} {entry.friendshipLevel}</span>}
              <button type="button" class="st-inline-link-btn" data-copy-episode-link>
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 9.5 9.5 6.5"/><path d="M8.5 11.5 7 13a2.8 2.8 0 0 1-4-4l1.5-1.5"/><path d="M7.5 4.5 9 3a2.8 2.8 0 0 1 4 4l-1.5 1.5"/></svg>
                <span>{shareCopy.copyLink}</span>
              </button>
            </div>
          </div>
          {entry.fallbackTextCount ? <p class="st-fallback-note">{en ? 'Lines without a translation show their official source language.' : '缺少译文的行使用官方原文，并标明语言。'}</p> : null}
        </header>

        <div class="st-reader-toolbar" data-reader-toolbar>
          <div class="st-reader-tools">
            <div class="st-toolbar-left">
              <details class="st-directory">
                <summary>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6h12M9 12h12M9 18h12M3 6h1M3 12h1M3 18h1"/></svg>
                  <span>{copy.directory}</span>
                  <span class="st-directory-count">{group.length}</span>
                  <svg class="st-directory-toggle" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
                </summary>
                <ol>{group.map(other => <li><a href={href(`/stories/episodes/${other.id}/`)} aria-current={other.id === entry.id ? "page" : undefined}><span class="st-directory-number">{String(other.episodeNumber).padStart(2, "0")}</span><span class="st-directory-title">{other.title}<small>{storyKindLabel(storyKind(other))}</small></span>{other.id === entry.id && <span class="st-directory-current" aria-hidden="true">●</span>}</a></li>)}</ol>
              </details>

              <a class="st-sticky-identity" href="#story-top" title={entry.title || episodeLabel(entry)}>
                <span class="st-sticky-ep">{episodeLabel(entry)}</span>
                <strong>{entry.title || episodeLabel(entry)}</strong>
              </a>
            </div>

            <div class="st-toolbar-right">
              <div class="st-font-seg" role="group" aria-label={copy.font}>
                <button type="button" data-story-font-btn="normal" aria-pressed="true">{copy.normal}</button>
                <button type="button" data-story-font-btn="large" aria-pressed="false">{copy.large}</button>
              </div>
              <button type="button" class="st-tool-icon-btn" data-find-toggle aria-expanded="false" aria-controls="story-find-panel" title={shareCopy.searchToggle} aria-label={shareCopy.searchToggle} hidden>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
              </button>
              <button class="st-share-trigger" type="button" data-share-toggle aria-pressed="false" aria-controls="story-selection" hidden>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8.5 8.5h7M8.5 12.5h7M8.5 16.5h4.5"/></svg>
                <span>{shareCopy.select}</span>
              </button>
            </div>
          </div>

          <story-reader-tools id="story-find-panel" class="st-reader-find" data-locale={activeReleaseContext.locale} hidden>
            <div class="st-find-row">
              <form role="search" aria-label={en ? 'Find dialogue in this episode' : '查找本话对白'}>
                <label class="st-find-query">
                  <span class="visually-hidden">{en ? 'Find dialogue' : '搜索对白'}</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
                  <input type="search" name="find" class="ui-input" placeholder={en ? 'Find dialogue…' : '搜索本话对白…'} autocomplete="off" />
                </label>
                <label class="st-find-speaker">
                  <span class="visually-hidden">{en ? 'Speaker' : '发言角色'}</span>
                  <select name="speaker" class="ui-select" aria-label={en ? 'Speaker' : '发言角色'}>
                    <option value="">{en ? 'All speakers' : '全部角色'}</option>
                    {speakers.map(name => <option value={name}>{name}</option>)}
                  </select>
                </label>
                <button type="submit" class="ui-btn-soft">{en ? 'Find' : '定位'}</button>
                <button type="reset" class="ui-btn-ghost">{en ? 'Clear' : '清除'}</button>
              </form>
              <div class="st-find-navigation">
                <span data-story-find-status role="status"></span>
                <button type="button" class="ui-icon-btn ui-icon-btn--outline" data-story-find-prev disabled aria-label={en ? 'Previous match' : '上一处匹配'}>
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 10-4-4-4 4"/></svg>
                </button>
                <button type="button" class="ui-icon-btn ui-icon-btn--outline" data-story-find-next disabled aria-label={en ? 'Next match' : '下一处匹配'}>
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
                </button>
                <a data-story-find-link hidden>{en ? 'Link' : '定位链接'}</a>
              </div>
            </div>
          </story-reader-tools>

          <div class="st-progress-track" aria-hidden="true"><div class="st-progress-bar" data-reading-progress></div></div>
        </div>

        <div class="st-reading-sheet">
          <div class="st-transcript" role="list" aria-label={entry.title}>
            {blocks.map(block => block.type === "chat-stage" ? (
              <section class="st-chat-stage" aria-label={shareCopy.chatStage}>
                <header class="st-chat-stage-head">
                  <span class="st-chat-stage-badge">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h11a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1H6l-3 2v-2h-.5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/></svg>
                    <span>{shareCopy.chatStage}</span>
                  </span>
                  {block.participants?.length > 0 && <span class="st-chat-participants">{block.participants.join(" · ")}</span>}
                </header>
                <ol class="st-chat-list">
                  {block.items.map((item: any) => (
                    <li
                      id={item.id}
                      class:list={[
                        "st-line",
                        `st-line--${item.kind}`,
                        "st-line--message",
                        {
                          "st-line--continuation": item.isContinuation,
                          "st-chat-msg--right": item.chatSide === "right",
                        },
                      ]}
                      data-story-line
                      data-line-kind={item.kind}
                      data-story-speaker={item.speaker}
                      data-continuation={item.isContinuation ? "true" : undefined}
                      style={item.character ? `--speaker-accent:${item.character.mainColor}` : undefined}
                    >
                      <button class="st-line-select" type="button" data-select-line={item.index} aria-label={shareCopy.line.replace("{n}", String(item.index + 1))} aria-pressed="false">
                        <span aria-hidden="true">{String(item.index + 1).padStart(2, "0")}</span>
                      </button>
                      <div class:list={["st-avatar", { "st-avatar--pair": !item.isContinuation && item.pairAvatars.length >= 2 }]} aria-hidden="true">
                        {!item.isContinuation && (
                          item.avatar ? (
                            <img src={item.avatar.thumbnailUrl} alt="" loading="lazy" width="32" height="32" />
                          ) : item.pairAvatars.length >= 2 ? (
                            item.pairAvatars.map((av: any) => <img src={av.thumbnailUrl} alt="" loading="lazy" width="20" height="20" />)
                          ) : (
                            <span>{item.speaker.slice(0, 2)}</span>
                          )
                        )}
                      </div>
                      <div class="st-message">
                        {!item.isContinuation && (
                          <div class="st-speaker">
                            <i class="st-speaker-dot" aria-hidden="true"></i>
                            <strong>{item.speaker}</strong>
                          </div>
                        )}
                        {item.kind === "stamp" ? (
                          <div class="st-stamp-card">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 10h.01M15.5 10h.01M8.5 14.5c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/></svg>
                            <p class="st-line-text"><span>{item.formattedText}</span></p>
                          </div>
                        ) : (
                          <p class="st-line-text"><span lang={item.locale ?? activeReleaseContext.locale}>{item.formattedText}</span>{item.fallbackLabel && <small class="st-fallback-locale">{item.fallbackLabel}</small>}</p>
                        )}
                      </div>
                      <div class="st-line-actions" aria-label={shareCopy.select}>
                        <button type="button" class="st-micro-btn" data-line-copy title={shareCopy.copyLine} aria-label={shareCopy.copyLine}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="7.5" height="8" rx="1.5"/><path d="M3 10.5V3.5A1.5 1.5 0 0 1 4.5 2H10"/></svg>
                        </button>
                        <button type="button" class="st-micro-btn" data-line-link title={shareCopy.copyLink} aria-label={shareCopy.copyLink}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 9.5 9.5 6.5"/><path d="M8.5 11.5 7 13a2.8 2.8 0 0 1-4-4l1.5-1.5"/><path d="M7.5 4.5 9 3a2.8 2.8 0 0 1 4 4l-1.5 1.5"/></svg>
                        </button>
                        <button type="button" class="st-micro-btn" data-line-quote title={shareCopy.quoteFromHere} aria-label={shareCopy.quoteFromHere}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2" width="11" height="12" rx="1.8"/><path d="M5.5 5.5h5M5.5 8.5h5M5.5 11h3"/></svg>
                        </button>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ) : block.type === "subtitle-stage" ? (
              <section class="st-subtitle-stage-block" aria-label={copy.subtitle}>
                <header class="st-subtitle-stage-head">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="2"/><path d="M5 10h6M5 7.5h3.5"/></svg>
                  <span>{copy.subtitle}</span>
                </header>
                <ol class="st-subtitle-list">
                  {block.items.map((item: any) => (
                    <li
                      id={item.id}
                      class:list={["st-line", "st-line--subtitle-row", { "st-line--continuation": item.isContinuation }]}
                      data-story-line
                      data-line-kind="subtitle"
                      data-story-speaker={item.speaker}
                      data-continuation={item.isContinuation ? "true" : undefined}
                      style={item.character ? `--speaker-accent:${item.character.mainColor}` : undefined}
                    >
                      <button class="st-line-select" type="button" data-select-line={item.index} aria-label={shareCopy.line.replace("{n}", String(item.index + 1))} aria-pressed="false">
                        <span aria-hidden="true">{String(item.index + 1).padStart(2, "0")}</span>
                      </button>
                      <div class="st-subtitle-row-body">
                        {item.speaker && !item.isContinuation && (
                          <span class="st-subtitle-who"><i class="st-speaker-dot" aria-hidden="true"></i>{item.speaker}</span>
                        )}
                        <p class="st-line-text"><span lang={item.locale ?? activeReleaseContext.locale}>{item.formattedText}</span>{item.fallbackLabel && <small class="st-fallback-locale">{item.fallbackLabel}</small>}</p>
                      </div>
                      <div class="st-line-actions" aria-label={shareCopy.select}>
                        <button type="button" class="st-micro-btn" data-line-copy title={shareCopy.copyLine} aria-label={shareCopy.copyLine}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="7.5" height="8" rx="1.5"/><path d="M3 10.5V3.5A1.5 1.5 0 0 1 4.5 2H10"/></svg>
                        </button>
                        <button type="button" class="st-micro-btn" data-line-link title={shareCopy.copyLink} aria-label={shareCopy.copyLink}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 9.5 9.5 6.5"/><path d="M8.5 11.5 7 13a2.8 2.8 0 0 1-4-4l1.5-1.5"/><path d="M7.5 4.5 9 3a2.8 2.8 0 0 1 4 4l-1.5 1.5"/></svg>
                        </button>
                        <button type="button" class="st-micro-btn" data-line-quote title={shareCopy.quoteFromHere} aria-label={shareCopy.quoteFromHere}>
                          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2" width="11" height="12" rx="1.8"/><path d="M5.5 5.5h5M5.5 8.5h5M5.5 11h3"/></svg>
                        </button>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ) : (() => {
              const item = block.item;
              return (
                <div
                  role="listitem"
                  id={item.id}
                  class:list={[
                    "st-line",
                    `st-line--${item.kind}`,
                    {
                      "st-line--message": item.isMessage,
                      "st-line--system": !item.isMessage,
                      "st-line--continuation": item.isContinuation,
                    },
                  ]}
                  data-story-line
                  data-line-kind={item.kind}
                  data-story-speaker={item.speaker}
                  data-continuation={item.isContinuation ? "true" : undefined}
                  style={item.character ? `--speaker-accent:${item.character.mainColor}` : undefined}
                >
                  <button class="st-line-select" type="button" data-select-line={item.index} aria-label={shareCopy.line.replace("{n}", String(item.index + 1))} aria-pressed="false">
                    <span aria-hidden="true">{String(item.index + 1).padStart(2, "0")}</span>
                  </button>

                  {item.kind === "location" ? (
                    <h2 class="st-scene-break">
                      <span class:list={["st-scene-pill", item.sceneKind === "time" ? "st-scene-pill--time" : "st-scene-pill--location"]} lang={item.locale ?? activeReleaseContext.locale}>
                        {item.sceneKind === "time" ? (
                          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.2 1.4"/></svg>
                        ) : (
                          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 14s4.5-3.8 4.5-7.5a4.5 4.5 0 1 0-9 0C3.5 10.2 8 14 8 14Z"/><circle cx="8" cy="6.5" r="1.4"/></svg>
                        )}
                        <span>{item.formattedText}</span>
                        {item.fallbackLabel && <small class="st-fallback-locale">{item.fallbackLabel}</small>}
                      </span>
                    </h2>
                  ) : item.isMessage ? (
                    <>
                      <div class:list={["st-avatar", { "st-avatar--pair": !item.isContinuation && item.pairAvatars.length >= 2 }]} aria-hidden="true">
                        {!item.isContinuation && (
                          item.avatar ? (
                            <img src={item.avatar.thumbnailUrl} alt="" loading="lazy" width="36" height="36" />
                          ) : item.pairAvatars.length >= 2 ? (
                            item.pairAvatars.map((av: any) => <img src={av.thumbnailUrl} alt="" loading="lazy" width="24" height="24" />)
                          ) : (
                            <span>{item.speaker.slice(0, 2)}</span>
                          )
                        )}
                      </div>
                      <div class="st-message">
                        {!item.isContinuation && (
                          <div class="st-speaker">
                            <i class="st-speaker-dot" aria-hidden="true"></i>
                            <strong>{item.speaker}</strong>
                          </div>
                        )}
                        <p class="st-line-text"><span lang={item.locale ?? activeReleaseContext.locale}>{item.formattedText}</span>{item.fallbackLabel && <small class="st-fallback-locale">{item.fallbackLabel}</small>}</p>
                      </div>
                    </>
                  ) : (
                    <div class="st-system-message st-narration-block">
                      <span class="st-system-label">{item.speaker || copy.narration}</span>
                      <p class="st-line-text"><span lang={item.locale ?? activeReleaseContext.locale}>{item.formattedText}</span>{item.fallbackLabel && <small class="st-fallback-locale">{item.fallbackLabel}</small>}</p>
                    </div>
                  )}

                  <div class="st-line-actions" aria-label={shareCopy.select}>
                    <button type="button" class="st-micro-btn" data-line-copy title={shareCopy.copyLine} aria-label={shareCopy.copyLine}>
                      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="7.5" height="8" rx="1.5"/><path d="M3 10.5V3.5A1.5 1.5 0 0 1 4.5 2H10"/></svg>
                    </button>
                    <button type="button" class="st-micro-btn" data-line-link title={shareCopy.copyLink} aria-label={shareCopy.copyLink}>
                      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 9.5 9.5 6.5"/><path d="M8.5 11.5 7 13a2.8 2.8 0 0 1-4-4l1.5-1.5"/><path d="M7.5 4.5 9 3a2.8 2.8 0 0 1 4 4l-1.5 1.5"/></svg>
                    </button>
                    <button type="button" class="st-micro-btn" data-line-quote title={shareCopy.quoteFromHere} aria-label={shareCopy.quoteFromHere}>
                      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2" width="11" height="12" rx="1.8"/><path d="M5.5 5.5h5M5.5 8.5h5M5.5 11h3"/></svg>
                    </button>
                  </div>
                </div>
              );
            })())}
          </div>
          <p class="st-end"><span>{copy.end}</span></p>
        </div>
      </div>

      <nav class="st-adjacent" aria-label={copy.group}>
        {previous ? (
          <a class="st-adjacent-card" href={href(`/stories/episodes/${previous.id}/`)} rel="prev">
            <small>← {copy.previous}</small>
            <strong>{previous.title}</strong>
            <span class="st-adjacent-kind">{episodeLabel(previous)}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="st-adjacent-card st-adjacent-card--next" href={href(`/stories/episodes/${next.id}/`)} rel="next">
            <small>{copy.next} →</small>
            <strong>{next.title}</strong>
            <span class="st-adjacent-kind">{episodeLabel(next)}</span>
          </a>
        ) : <span />}
      </nav>

      <div class="st-reader-bottom">
        <a class="ui-btn-ghost" href={href(entry.eventId != null ? `/stories/events/#event-${entry.eventId}` : `/stories/${kind}/`)}>← {copy.back}</a>
        <div class="st-reader-bottom-right">
          <button type="button" class="ui-btn-ghost" data-copy-episode-link>{shareCopy.copyLink}</button>
          <a class="ui-btn-soft" href="#story-top">↑ {copy.top}</a>
        </div>
      </div>

      <details class="st-source"><summary>{copy.source}</summary><p>{copy.notice} {copy.sourceNote}</p></details>

      {/* Direct Text-Selection Floating Share Pill (划词即分享) */}
      <div class="st-sel-popover" data-selection-popover hidden role="toolbar" aria-label={shareCopy.select}>
        <button type="button" class="st-pop-btn st-pop-btn--primary" data-pop-card>
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2" width="11" height="12" rx="1.8"/><path d="M5.5 5.5h5M5.5 8.5h5M5.5 11h3"/></svg>
          <span>{shareCopy.generate}</span>
        </button>
        <button type="button" class="st-pop-btn" data-pop-copy><span>{shareCopy.copyText}</span></button>
        <button type="button" class="st-pop-btn" data-pop-link><span>{shareCopy.copyLink}</span></button>
      </div>

      {/* Floating Bottom Dock for Multi-Line Selection Mode */}
      <section class="st-selection" id="story-selection" aria-label={shareCopy.select} hidden>
        <div class="st-selection-info">
          <span class="st-selection-status" data-selection-status role="status">{shareCopy.empty}</span>
          <p data-selection-hint>{shareCopy.hint}</p>
        </div>
        <div class="st-selection-actions">
          <button type="button" class="ui-btn-ghost" data-selection-reset>{shareCopy.reset}</button>
          <button type="button" class="ui-btn-outline" data-selection-copy disabled>{shareCopy.copyText}</button>
          <button type="button" class="ui-btn-primary st-primary" data-selection-generate disabled>{shareCopy.generate}</button>
          <button type="button" class="ui-icon-btn ui-icon-btn--circle" data-selection-cancel aria-label={shareCopy.cancel} title={shareCopy.cancel}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        <p class="st-share-error" data-selection-error role="alert" hidden></p>
      </section>

      <dialog class="st-share-dialog" data-share-dialog aria-labelledby="story-share-title" aria-describedby="story-share-tip">
        <header>
          <div>
            <p>OTONOTE · {shareCopy.excerpt}</p>
            <h2 id="story-share-title">{shareCopy.preview}</h2>
          </div>
          <div class="st-share-header-actions">
            <div class="st-share-theme-seg" role="group" aria-label={shareCopy.preview}>
              <button type="button" data-share-theme="light" aria-pressed="true">{shareCopy.themeLight}</button>
              <button type="button" data-share-theme="dark" aria-pressed="false">{shareCopy.themeDark}</button>
            </div>
            <button type="button" class="ui-icon-btn ui-icon-btn--circle ui-icon-btn--outline" data-share-close aria-label={shareCopy.close}>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
        </header>
        <div class="st-share-preview"><img data-share-image alt={shareCopy.preview} /></div>
        <div class="st-share-dialog-footer">
          <div class="st-share-meta-copy">
            <p id="story-share-tip">{shareCopy.tip}</p>
            <p data-share-result role="status"></p>
            <p class="st-share-error" data-share-error role="alert" hidden></p>
          </div>
          <div class="st-share-buttons">
            <button type="button" class="ui-btn-ghost" data-share-edit>{shareCopy.edit}</button>
            <button type="button" class="ui-btn-outline" data-share-copy-image hidden>{shareCopy.copyImage}</button>
            <button type="button" class="ui-btn-soft" data-share-native hidden>{shareCopy.share}</button>
            <a class="ui-btn-primary st-primary" data-share-save download>{shareCopy.save}</a>
          </div>
        </div>
      </dialog>
    </article>
  </div>
</BaseLayout>
<script>
  import "../../../lib/story-reader-tools.mjs";
  import { setupStoryShare } from "../../../lib/story-share";
  const reader = document.querySelector<HTMLElement>("[data-text-reader]");
  const header = reader?.querySelector<HTMLElement>("[data-reader-header]");
  const toolbar = reader?.querySelector<HTMLElement>("[data-reader-toolbar]");
  const directory = reader?.querySelector<HTMLDetailsElement>(".st-directory");
  const fontButtons = [...(reader?.querySelectorAll<HTMLButtonElement>("[data-story-font-btn]") ?? [])];
  const progressBar = reader?.querySelector<HTMLElement>("[data-reading-progress]");

  const applyFont = (size: string) => {
    if (!reader) return;
    const normalized = size === "large" ? "large" : "normal";
    reader.dataset.font = normalized;
    fontButtons.forEach(btn => btn.setAttribute("aria-pressed", String(btn.dataset.storyFontBtn === normalized)));
    try { sessionStorage.setItem("otonote:story-font", normalized); } catch {}
  };

  try {
    const savedFont = sessionStorage.getItem("otonote:story-font");
    if (savedFont) applyFont(savedFont);
  } catch {}

  fontButtons.forEach(btn => btn.addEventListener("click", () => applyFont(btn.dataset.storyFontBtn || "normal")));

  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && directory?.open) {
      event.preventDefault();
      directory.open = false;
      directory.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", event => {
    if (directory?.open && event.target instanceof Node && !directory.contains(event.target)) {
      directory.open = false;
    }
  });

  if (header && toolbar && typeof IntersectionObserver !== "undefined") {
    const observer = new IntersectionObserver(
      entries => {
        const scrolledPast = !entries[0].isIntersecting;
        toolbar.toggleAttribute("data-scrolled", scrolledPast);
      },
      { rootMargin: "-64px 0px 0px 0px", threshold: 0 },
    );
    observer.observe(header);
  }

  if (progressBar && reader) {
    let raf = 0;
    const updateProgress = () => {
      raf = 0;
      if (header && toolbar) {
        toolbar.toggleAttribute("data-scrolled", header.getBoundingClientRect().bottom < 72);
      }
      const sheet = reader.querySelector<HTMLElement>(".st-reading-sheet");
      if (!sheet) return;
      const rect = sheet.getBoundingClientRect();
      const total = Math.max(1, sheet.offsetHeight - window.innerHeight * 0.65);
      const passed = Math.min(total, Math.max(0, -rect.top + window.innerHeight * 0.15));
      progressBar.style.transform = `scaleX(${(passed / total).toFixed(4)})`;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(updateProgress); };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    window.addEventListener("hashchange", onScroll);
    updateProgress();
  }

  if (reader) setupStoryShare(reader);
</script>
