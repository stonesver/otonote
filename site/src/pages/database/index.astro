---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {itemIndex, skillIndex} from "../../lib/shared-database";
import { bandItemDatabase } from "../../lib/shared-band-items";
import "../../styles/database.css";

---

<BaseLayout title="游戏数据库">

  <section class="db-directory">
    <div class="content-shell">
      <p class="db-version">日服与国际版合并收录</p>

      <div class="db-ledger">
        <a class="db-ledger-row" href="/database/skills/">
          <span class="db-ledger-code">SKL</span>
          <div>
            <small>技能、效果、条件与目标</small>
            <h2>技能索引</h2>
            <p>五类技能的全部等级、条件分支、目标和关联卡牌。</p>
          </div>
          <strong>{skillIndex.length}</strong>
          <span class="db-ledger-arrow">→</span>
        </a>
        <a class="db-ledger-row" href="/database/items/">
          <span class="db-ledger-code">ITM</span>
          <div>
            <small>材料、用途与反向关系</small>
            <h2>道具索引</h2>
            <p>查看道具被哪些技能等级、Rank 或觉醒阶段使用。</p>
          </div>
          <strong>{itemIndex.length}</strong>
          <span class="db-ledger-arrow">→</span>
        </a>
        <a class="db-ledger-row" href="/database/band-items/">
          <span class="db-ledger-code">ENH</span>
          <div>
            <small>BAND ITEM / LEVEL 1–10</small>
            <h2>乐队强化</h2>
            <p>查看 Enhance 物件、所属乐队与每一级的全队参数加成。</p>
          </div>
          <strong>{bandItemDatabase.items.length}</strong>
          <span class="db-ledger-arrow">→</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
