---
import "../styles/calculator-workflow.css";
import CalculatorSongPicker from "./CalculatorSongPicker.astro";
import GekisouOpponentInputs from "./GekisouOpponentInputs.astro";
import CalculatorStrategyGuide from "./CalculatorStrategyGuide.astro";
import {memberCards,supportCards} from "../lib/inventory-catalog";
import {bandItemDatabase} from "../lib/band-items";
import { catalog, getAsset } from "../lib/catalog";
import { cardDetailProjections } from "../lib/game-card-data";
import { scoringEvidence } from "../lib/scoring-capability";
import { globalSystems } from "../lib/global-systems";
import { activeReleaseContext } from "../lib/release-context";
import { getRuntimeUiLabels } from "../lib/runtime-ui-labels";
import {sharedTeamPresentation} from "../lib/shared-team-presentation.mjs";
import "../styles/task-workbench.css";
import "../styles/task-prototype-theme.css";
import formalRules from "../data/formal-scoring-rules.json";
import { scoringRulesAvailable } from "../lib/scoring-release-gate.mjs";
import ScoringUnavailable from "./ScoringUnavailable.astro";
import ScoringModelNotice from './ScoringModelNotice.astro';

const rulesAvailable = scoringRulesAvailable(formalRules, catalog.release.id);
const runtimeUi = getRuntimeUiLabels(activeReleaseContext.locale);
const vipRanks = globalSystems.sourceReleaseId === catalog.release.id
  ? globalSystems.vipRanks
  : [];
const clientData = JSON.stringify({
  ...sharedTeamPresentation(),
  locale:runtimeUi.locale,
  bands:catalog.bands.map(b=>({id:b.masterId,name:b.displayName})),
  characters:catalog.characters.map(c=>({id:c.masterId,name:c.displayName})),
  instruments:bandItemDatabase.items.map(i=>({id:i.masterId,name:i.name})),
  sourceReleaseId: catalog.release.id,
  formalRules,
  vipRanks,
  memberCards,
  supportCards,
  projections: [
    ...cardDetailProjections.memberCards,
    ...cardDetailProjections.supportCards
  ].map((projection) => ({
    cardId: projection.cardId,
    skillSummaries: projection.skillSummaries
  })),
  tracks: catalog.musicTracks,
  charts: catalog.musicCharts.map((chart) => ({
    id: chart.id,
    trackId: chart.trackId,
    difficulty: chart.difficulty,
    level: chart.level,
    duration: chart.duration,
    fullComboCount: chart.fullComboCount,
    analysisDataUrl: chart.analysisDataUrl
  })),
  evidence: scoringEvidence,
  labels: runtimeUi.scoringResearch
}).replaceAll("<", "\\u003c");
---

{rulesAvailable ? <scoring-research-workbench class="scoring-research-workbench">
  <script is:inline type="application/json" data-scoring-research-data set:html={clientData}></script>
  <div class="score-preparation"><section class="tool-saved-team"><h2>用哪支队伍计算？</h2><div class="calculator-links"><button type="button" data-open-team-workspace="teams">卡库与队伍</button><button type="button" data-save-current-team>存为队伍</button></div><p data-team-workspace-status role="status"></p><p data-score-team-note role="status"></p><div class="tool-team-strip" data-score-team></div><div class="calculator-links"><a href="#song-result">查看计算结果 ↓</a><button type="button" data-open-team-workspace="teams">编辑当前队伍</button><a href="/tools/event-efficiency/" data-event-efficiency-link>带入活动收益 →</a></div></section>
  <details class="tool-song-disclosure" data-score-song-picker open><summary>选择或更换歌曲 <span data-score-song-name>点击难度选定谱面</span></summary><CalculatorSongPicker /></details>
  <div class="calculator-song-fields" hidden><label>歌曲<select data-calculator-song><option value="">选择歌曲</option>{catalog.musicTracks.map(track=><option value={track.id}>{track.title}</option>)}</select></label><label>难度<select data-calculator-difficulty><option value="">选择难度</option>{['easy','normal','hard','expert'].map(d=><option value={d}>{d.toUpperCase()}</option>)}</select></label></div>
  </div><section class="score-output" id="song-result" aria-label="歌曲计算结果与演出设置">
  <section class="scoring-research-summary" aria-labelledby="scoring-research-title">
    <div>
      <span class="tool-status tool-status--experimental">整曲分数估算</span>
      <h2 id="scoring-research-title" data-score-result-title>当前歌曲期望分数</h2>
      <p data-score-result-assumption>默认全 Perfect（AP）、满生命。不同技能顺序会带来分数变化，以下显示参考平均分和范围。</p>
    </div>
    <dl>

      <div><dt>输入状态</dt><dd data-scoring-input-status>等待加载</dd></div>
      <div><dt>期望分数（估算）</dt><dd data-song-score>等待加载</dd></div>
    </dl>
  </section>
  <label>演出模式 <select data-scoring-mode data-quick><option value="ordinary">普通自由演出</option><option value="gekisou">激奏演出</option></select></label>
  <label>按什么发挥计算？ <select data-score-performance-profile><option value="saved">沿用队伍保存的发挥</option><option value="steady">参考发挥</option><option value="practice">练习中的发挥</option><option value="ideal">理想发挥</option><option value="legacy">全 Perfect、满生命参考</option></select></label>
  <details class="calculator-extra" data-performance-settings><summary>逐音符判定回放 <span>可选，指定操作与技能顺序</span></summary><div class="calculator-extra-body">
    <label>判定条件 <select data-performance-mode><option value="ap">全 Perfect、满生命参考</option><option value="explicit">使用输入的逐音符判定</option></select></label>
    <p>模板包含当前谱面的全部计分节点。修改 judgement 和 inputFrame 后应用，按指定技能顺序回放一次。1＝Miss、2＝Bad、3＝Good、4＝Great、5＝Perfect、6＝Just。帧序号从 0 开始；scoreIndex、timeMs 与谱面标识请保留。</p>
    <div class="scoring-research-actions"><button type="button" data-performance-template>下载当前谱面模板</button><label>导入 JSON <input type="file" accept="application/json,.json" data-performance-file /></label></div>
    <label>判定 JSON<textarea data-performance-json rows="7" spellcheck="false" placeholder="选择歌曲后下载模板，填写并导入，或在此粘贴 JSON"></textarea></label>
    <div class="scoring-research-actions"><button type="button" data-performance-apply>应用并计算</button><button type="button" data-performance-reset>恢复 AP 参考</button></div>
    <p data-performance-status role="status">尚未导入判定。模板是可编辑的模拟输入，不是实战记录。</p>
  </div></details>
  <details class="calculator-extra" data-gekisou-scenario hidden><summary>调整激奏情景 <span>名次、对手与随机条件</span></summary><div class="calculator-extra-body">
    <label>固定判定偏差（毫秒）<input data-gekisou-offset type="number" min="-50" max="50" step="1" value="0" /></label>
    {[1, 2, 3].map(i => <label>第 {i} 段名次 <select data-gekisou-rank>{[1, 2, 3, 4, 5].map(rank => <option value={rank}>{rank}</option>)}</select></label>)}
    {[1, 2, 3].map(i => <label>第 {i} 段结果确认额外等待（帧）<input data-gekisou-confirmation type="number" min="0" max="3600" step="1" value="0" /></label>)}
    <GekisouOpponentInputs />
    <label>抽样批数（每批 120 次）<input data-gekisou-batches type="number" min="1" max="32" step="1" value="1" /></label>
    <label>随机种子 <input data-gekisou-seed type="number" min="0" max="4294967295" step="1" value="20260927" /></label>
    <label>逐帧模拟 <select data-gekisou-fps><option value="60">60 FPS</option><option value="30">30 FPS</option><option value="120">120 FPS</option></select></label>
    <p>零偏差会让可判 JUST 的音符获得 JUST；普通 AP 不保证这一点。按理想时钟逐帧计算，名次可指定或由下方对手数据算出。LUCK 为概率抽样，最低／最高分是样本范围。</p>
  </div></details>
  <p data-song-score-details aria-live="polite"></p>
  <p data-performance-summary aria-live="polite" hidden></p>
  <div data-skill-activation></div>

  </section>
  <details class="tool-help"><summary>查看队伍输入与计算明细</summary><div class="scoring-research-grid">
    <article class="scoring-research-panel">
      <span>当前队伍与歌曲</span>
      <h3>本次输入</h3>
      <dl data-scoring-input-summary>
        <div><dt>歌曲</dt><dd>未选择</dd></div>
        <div><dt>难度</dt><dd>未选择</dd></div>
        <div><dt>卡牌</dt><dd>0</dd></div>
        <div><dt>T.G.W CARD</dt><dd>未选择</dd></div>
        <div><dt>谱面对象</dt><dd>0</dd></div>
        <div><dt>FC 计数</dt><dd>0</dd></div>
      </dl>
      <p class="scoring-input-hash"><span>INPUT HASH</span><code data-scoring-input-hash>—</code></p>
      <div class="scoring-research-actions">
        <span>更换卡片时，使用上方“编辑当前队伍”。</span>
      </div>
    </article>

    <article class="scoring-research-panel scoring-research-panel--trace">
      <span>逐项解释</span>
      <h3>计算明细与核验范围</h3>
      <ol data-scoring-trace aria-live="polite">
        <li>正在建立输入快照…</li>
      </ol>
    </article>
  </div>

  </details>
  <details class="tool-help"><summary>配队攻略与估算说明</summary><ScoringModelNotice /><CalculatorStrategyGuide ruleVersion={formalRules.ruleSetVersion} /></details>
  <details class="scoring-snapshot-details">
    <summary>查看输入、技能与逐音符计分 JSON（本次样本）</summary>
    <pre data-scoring-snapshot-json>{}</pre>
  </details>
</scoring-research-workbench> : <ScoringUnavailable />}

<script>
  import "../lib/scoring-research-workbench.mjs";
</script>
