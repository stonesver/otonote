---
import '../styles/workbench-controls.css';
import '../styles/playlist-workspace.css';
---
<div data-playlist-workspace-host></div>
<script>
 type ScopeController=ReturnType<typeof import('../lib/calculation-scope-ui.mjs').createCalculationScopeControl>;
 const sidebarLauncher=document.querySelector<HTMLButtonElement>('[data-playlist-workspace-open]');
 const sidebarLabel=sidebarLauncher?.querySelector('span')??null;
 const dockLaunchers=[...document.querySelectorAll<HTMLButtonElement>('[data-workspace-quick-open="playlist"]')];
 const english=document.documentElement.lang==='en';
 const copy=english?{open:'My playlists',loading:'Opening…',failed:'Could not load. Try again'}:{open:'我的歌单',loading:'正在打开…',failed:'加载失败，点击重试'};
 if(sidebarLauncher){sidebarLauncher.disabled=false;sidebarLauncher.title=copy.open;}
 let standalone:ScopeController|undefined,loading=false;
 document.addEventListener('playlist-workspace:open',async()=>{
  if(loading)return;
  const active=[...document.querySelectorAll<HTMLElement & {playlistController?:ScopeController}>('.calculation-scope')].map(n=>n.playlistController).find(Boolean);
  const closeOthers=()=>document.querySelectorAll<HTMLDialogElement>('.account-hub-dialog[open], .tw-panel[open]').forEach(d=>d.close());
  if(active){active.openManager();closeOthers();return;}
  loading=true;
  if(sidebarLauncher){sidebarLauncher.disabled=true;sidebarLauncher.setAttribute('aria-busy','true');}
  dockLaunchers.forEach(btn=>btn.setAttribute('aria-busy','true'));
  if(sidebarLabel)sidebarLabel.textContent=copy.loading;
  try{
   if(!standalone){const [{createCalculationScopeControl},{sharedPlaylistData}]=await Promise.all([import('../lib/calculation-scope-ui.mjs'),import('../lib/shared-playlist-data.mjs')]);const host=document.querySelector<HTMLElement>('[data-playlist-workspace-host]');if(!host)return;const mount=document.createElement('div');mount.hidden=true;host.append(mount);standalone=createCalculationScopeControl({host,mount,data:sharedPlaylistData(),toolKey:'library',standalone:true});}
   standalone.openManager();
   closeOthers();
  }catch{if(sidebarLabel)sidebarLabel.textContent=copy.failed;}finally{
   loading=false;
   if(sidebarLauncher){sidebarLauncher.disabled=false;sidebarLauncher.removeAttribute('aria-busy');}
   dockLaunchers.forEach(btn=>btn.removeAttribute('aria-busy'));
   if(sidebarLabel?.textContent===copy.loading)sidebarLabel.textContent=copy.open;
  }
 });
</script>
