---
import '../styles/shared-team-workspace.css';
const en = Astro.props.locale === 'en';
---
<div data-team-workspace-shell>
  <button type="button" class="tw-launcher" data-team-workspace-open aria-haspopup="dialog" aria-expanded="false">{en ? 'Cards & teams' : '卡库与队伍'}</button>
  <dialog class="tw-panel" data-team-workspace-panel aria-labelledby="tw-title">
    <header class="tw-heading"><div><small>OTONOTE / MY TEAMS</small><h2 id="tw-title">{en ? 'Cards & teams' : '卡库与队伍'}</h2></div><button type="button" data-team-workspace-close aria-label={en?'Close':'关闭'}>×</button></header>
    <div class="tw-body" data-team-workspace-body><p role="status">{en?'Loading your collection…':'正在读取卡库与队伍…'}</p></div>
  </dialog>
</div>
<script>
  const shell = document.querySelector('[data-team-workspace-shell]');
  if (shell) {
    let workspace;
    const open = async (event: Event) => {
      const detail = event instanceof CustomEvent ? event.detail : undefined;
      try {
        workspace ??= import('../lib/shared-team-workspace.mjs').then(m => m.setupSharedTeamWorkspace(shell));
        await (await workspace).open(detail?.tab, event.type === 'team-workspace:save' ? detail : null);
      } catch (error) {
        workspace = null;
        const message = error instanceof Error ? error.message : String(error);
        const body = shell.querySelector('[data-team-workspace-body]');
        if(body) body.textContent = document.documentElement.lang === 'en' ? `Could not open: ${message}` : `暂时无法打开：${message}`;
        const panel = shell.querySelector('dialog'); if(panel && !panel.open)panel.showModal();
      }
    };
    shell.querySelector('[data-team-workspace-open]')?.addEventListener('click', open);
    document.addEventListener('team-workspace:open', open);
    document.addEventListener('team-workspace:save', open);
    shell.querySelector('[data-team-workspace-close]')?.addEventListener('click', () => shell.querySelector('dialog')?.close());
  }
</script>
