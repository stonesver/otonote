# Copy to /etc/ournotes/r2-prerender.env (non-secret). Pin an image built
# from the reviewed main commit. Use either its registry digest or the local
# immutable image ID after verifying and streaming the Actions archive.
R2_PRERENDER_IMAGE=ghcr.io/OWNER/otonote-r2-prerender@sha256:REPLACE_WITH_DIGEST
R2_PRERENDER_SOURCE_REVISION=REPLACE_WITH_MAIN_COMMIT
R2_PRERENDER_UID=REPLACE_WITH_EXISTING_RENDER_UID
R2_PRERENDER_GID=REPLACE_WITH_EXISTING_RENDER_GID
# Measure each increment, then add explicit margin. If paths share a device,
# the wrapper sums these numbers before pulling the image.
R2_PRERENDER_DOCKER_FREE_BYTES=REPLACE_WITH_IMAGE_DOWNLOAD_AND_UNPACK_BYTES_PLUS_MARGIN
R2_PRERENDER_CONTENT_FREE_BYTES=REPLACE_WITH_BOTH_SELECTED_RELEASES_BYTES_PLUS_MARGIN
R2_PRERENDER_RENDERED_FREE_BYTES=REPLACE_WITH_BOTH_STAGED_HTML_RELEASES_BYTES_PLUS_MARGIN
