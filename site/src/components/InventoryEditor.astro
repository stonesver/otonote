---
import {filterVisual} from '../lib/filter-visuals';
const optionVisual = (kind: string, value: string | number) => {
  const visual = filterVisual(kind, String(value));
  return {'data-icon': visual.icon, 'data-icon-only': visual.iconOnly ? 'true' : undefined, 'data-round': visual.round ? 'true' : undefined};
};
import {activeReleaseContext} from '../lib/release-context';
import {siteHref} from '../lib/site-context';
import SelectionFilters from "./SelectionFilters.astro";
import {catalog} from "../lib/catalog";
import CalculatorAttributeFilter from "./CalculatorAttributeFilter.astro";
import AccountGrowthImport from './AccountGrowthImport.astro';
import ScreenshotImport from './ScreenshotImport.astro';
interface Props {
  standalone?: boolean;
  attributes?: {value:number;label:string}[];
  rarities?: {value:number;label:string}[];
}
const {rarities=[], standalone=false} = Astro.props;
---
<details class:list={['calculator-extra inventory-editor',{'inventory-editor--album':standalone}]} data-inventory-editor open={standalone}>
  <summary>{standalone?'我的卡库':'管理我的卡库'} <span data-inventory-count>卡面点选 · 批量养成 · 表格导入</span></summary>
  <div class="inventory-body">
    {!standalone && <p class="inventory-help">此卡库与 <a href={import.meta.env.BASE_URL==='/'?'/my-growth/':siteHref('/my-growth/',activeReleaseContext)}>我的养成</a> 共用，修改后供其他工具使用。</p>}
    {!standalone && <AccountGrowthImport />}
    <div class="inventory-import-entry"><div><strong>把游戏里的卡库带过来</strong><p>选择截图，自动识别卡牌与养成，再确认导入。</p></div><button type="button" data-inventory-screenshot class="growth-primary"><span aria-hidden="true">▧</span> 截图导入 <span aria-hidden="true">→</span></button></div>
    <p class="inventory-help inventory-intro">点卡面编辑养成；勾选左上角可批量修改。</p>
    <div class="inventory-toolbar inventory-library-actions">
      <button type="button" data-inventory-from-draft hidden={standalone}>加入当前编成</button>
      <button type="button" data-inventory-use hidden={standalone}>用我的卡库配队</button>
      <button type="button" data-inventory-undo disabled>撤销上次修改</button>
      <button type="button" data-inventory-export>导出养成备份</button>
    </div>
    <ScreenshotImport />
    <p data-inventory-status role="status"></p>
      <label hidden={standalone}>卡片类型<select data-inventory-kind><option value="member">成员卡</option><option value="support">留影</option></select></label>
    {standalone && <div class="inventory-collection-tabs">
      <div class="inventory-kind-tabs" role="group" aria-label="卡片类型"><button type="button" data-inventory-kind-tab="member" aria-pressed="true">成员卡</button><button type="button" data-inventory-kind-tab="support" aria-pressed="false">留影</button></div>
      <div class="inventory-owned-tabs" role="group" aria-label="持有范围"><button type="button" data-inventory-owned-tab="" aria-pressed="true">全部</button><button type="button" data-inventory-owned-tab="owned" aria-pressed="false">已拥有</button><button type="button" data-inventory-owned-tab="missing" aria-pressed="false">未录入</button></div>
    </div>}
    <SelectionFilters title="筛选我的卡库">
      <label slot="search" class="selection-search">搜索卡片<input type="search" data-inventory-query placeholder="卡名、角色、乐队或 ID" /></label>
    <div slot="quick" class="selection-filter-rows">
      <div data-inventory-attributes><CalculatorAttributeFilter label="筛选卡库属性" /></div>
      <label class="selection-filter-row"><span>稀有度</span><select data-inventory-rarity data-quick><option value="">全部</option>{rarities.map(r=><option value={r.value} {...optionVisual('rarity', r.value)}>{r.label}</option>)}</select></label>
      <label class="selection-filter-row"><span>乐队</span><select data-inventory-band data-quick><option value="">全部乐队</option>{catalog.bands.map(b=><option value={b.id} {...optionVisual('band', b.id)}>{b.displayName}</option>)}</select></label>
    </div>
    <div class="inventory-filters selection-filter-rows">
      <label class="selection-filter-row"><span>角色</span><select data-inventory-character><option value="">全部角色</option>{catalog.characters.map(c=><option value={c.id} data-band={c.bandId}>{c.displayName}</option>)}</select></label>
      <label class="selection-filter-row"><span>激奏类型</span><select data-inventory-mission><option value="">全部类型</option><option value="combo">COMBO</option><option value="luck">LUCK</option><option value="just">JUST</option></select></label>
      <label class="selection-filter-row"><span>技能效果</span><select data-inventory-effect><option value="">全部激奏效果</option></select></label>
      <label class="selection-filter-row"><span>普通技能</span><select data-inventory-normal><option value="">全部普通技能</option><option value="simple">纯加分</option><option value="life">血量条件加分</option><option value="judgement">判定条件加分</option><option value="score">分卡 / 延时</option><option value="judge">判定辅助</option><option value="heal">生命回复</option></select></label>
      <label class="selection-filter-row"><span>排序</span><select data-inventory-sort><option value="rarity">稀有度优先</option><option value="newest">卡片编号从新到旧</option><option value="name">名称</option></select></label>
      <label class="selection-filter-row"><span>持有情况</span><select data-inventory-owned><option value="">全部卡片</option><option value="owned">已拥有</option><option value="missing">未录入</option></select></label>
    </div>

    <span slot="results" data-inventory-filter-count data-filter-count role="status"></span><button slot="results" type="button" data-inventory-reset data-filter-reset>重置筛选</button>
    </SelectionFilters>
    <div class="inventory-toolbar inventory-selection">
      <span data-inventory-selection-count>已选 0 张</span>
      <button type="button" data-inventory-select-page>选择本页</button>
      <button type="button" data-inventory-select-visible>全选筛选结果</button>
      <button type="button" data-inventory-edit-selected class="growth-primary" disabled>批量修改</button>
      <button type="button" data-inventory-clear-selection>清空选择</button>
      <button type="button" data-inventory-add title="已有卡牌保留原养成">加入卡库</button>
      <button type="button" data-inventory-remove>移出卡库</button>
    </div>
    <div class="inventory-grid" data-inventory-cards></div>
    <dialog class="inventory-edit-dialog" data-inventory-edit-dialog aria-label="修改卡片养成">
      <form data-inventory-edit-form>
        <header class="inventory-edit-heading"><h2 tabindex="-1">修改养成</h2><button type="button" data-inventory-edit-close aria-label="取消并关闭修改养成">×</button></header>
        <div class="inventory-edit-identity"><img data-inventory-edit-image alt="" hidden /><div><strong data-inventory-edit-name></strong><p data-inventory-edit-relation></p></div></div>
        <p class="inventory-help" data-inventory-edit-help>修改后供配队和计算工具使用，保存前可随时恢复原值。</p>
        <details class="inventory-edit-targets" data-inventory-edit-targets hidden><summary></summary><ul></ul></details>
        <div class="inventory-edit-presets" role="group" aria-label="快捷养成">
          <button type="button" data-inventory-edit-preset="level"><strong>一键满级</strong><small>只改等级，保留阶数与技能</small></button>
          <button type="button" data-inventory-edit-preset="skills"><strong>一键满技能</strong><small>演出与激奏技能一起升满</small></button>
          <button type="button" data-inventory-edit-preset="maximum"><strong>一键满养成</strong><small>等级、阶数、技能全部升满</small></button>
        </div>
        <div class="inventory-growth-fields">
          {Object.entries({level:'等级',rank:'突破阶数',awake:'觉醒阶数',skillLevel:'演出技能等级',gekisouSkillLevel:'激奏技能等级'}).map(([field,label])=><label data-inventory-edit-label={field}><span data-inventory-edit-title={field}>{label}</span><select aria-label={label} data-inventory-edit-field={field}></select><small data-inventory-edit-range={field}></small></label>)}
        </div>
        <div class="inventory-toolbar inventory-edit-shortcuts"><button type="button" data-inventory-edit-reset>恢复原值</button></div>
        <p data-inventory-edit-status role="status" aria-live="polite"></p>
        <footer class="inventory-toolbar inventory-edit-actions"><button type="submit" class="growth-primary" disabled>保存修改</button><button type="button" data-inventory-edit-cancel>取消</button></footer>
      </form>
    </dialog>
    <div class="inventory-pagination"><button type="button" data-inventory-prev>上一页</button><span data-inventory-page></span><button type="button" data-inventory-next>下一页</button></div>
    <details class="inventory-import-panel inventory-sheet-import">
      <summary>粘贴名单或导入表格 <span>Excel / CSV / JSON 备份</span></summary>
      <p class="inventory-help">可直接粘贴 Excel 表格，或每行一个完整卡名／卡片 ID。模板支持等级、突破阶数、觉醒阶数和两种技能等级。名称不唯一时请用 ID；缺少的养成按下方选择补齐。</p>
      <div class="inventory-toolbar">
        <label>清单类型 <select data-inventory-import-kind><option value="member">成员卡</option><option value="support">留影</option></select></label>
        <label>新卡缺省养成 <select data-inventory-import-preset><option value="minimum">等级 1／阶数 1／技能 1</option><option value="maximum">满养成（请确认实际持有）</option></select></label>
        <label class="inventory-check"><input type="checkbox" data-inventory-overwrite />更新已有卡的已填写字段</label>
      </div>
      <label class="inventory-paste-label">卡片清单<textarea data-inventory-paste rows="5" placeholder="member-card-1&#10;member-card-2"></textarea></label>
      <div class="inventory-toolbar">
        <label>读取文件 <input type="file" accept=".json,.csv,.tsv,.txt,application/json,text/csv,text/plain" data-inventory-import /></label>
        <button type="button" data-inventory-template>下载 CSV 模板</button>
        <button type="button" data-inventory-preview>预览导入</button>
        <button type="button" data-inventory-apply disabled>确认合并到卡库</button>
      </div>
      <div data-inventory-preview-results class="inventory-preview" aria-live="polite"></div>
    </details>
  </div>
</details>
