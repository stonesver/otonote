# The service selects the active event from the site's verified current Global content.
RANKING_CAPTURE_IMAGE=ournotes-player-rankings-capture:verified
# Private SDK resource path: replace in the external environment file only.
RANKING_SDK_RESOURCES=/path/to/private/ranking-sdk-resources.xml
# Pin RANKING_CAPTURE_IMAGE to the built image digest during deployment.
# Account/password are separate private files under credentials/, mounted
# read-only into the capture container. Never include them in this file/image.
# SDK XML likewise stays outside Git and image layers. UID 10001 must be able
# to read its mounted file; keep host access restricted to the operator/service.
