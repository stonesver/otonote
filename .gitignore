!/analysis/*.py
!/analysis/*.md
!/analysis/*.json
!/analysis/requirements.txt
!/analysis/crypto/
/analysis/crypto/*
!/analysis/crypto/*.py
!/analysis/crypto/*.md
!/analysis/crypto/verify_chart_catalog.mjs
