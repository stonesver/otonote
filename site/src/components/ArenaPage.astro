---
import {activeReleaseContext} from '../lib/release-context';
import {filterVisualOptions,bandCircleIcon} from '../lib/filter-visuals';
import {catalog,getAsset,type MemberCard,type SupportCard} from '../lib/catalog';
import itemIndexData from '@projection-data/database-shards/items-index.json';
import {validateArtifact} from '../lib/artifact-contracts';
import type {ItemIndexRecord} from '../lib/game-database';
import '../styles/arena.css';
import '../styles/arena-calendar.css';
import '../styles/tool-design-system.css';
import '../styles/ranking-teaser.css';
const {handoff=false}=Astro.props;
const en=activeReleaseContext.locale==='en';
const itemIndex=validateArtifact<{schemaVersion:number;records:ItemIndexRecord[]}>('database-shards/items-index.json',itemIndexData,{schemaVersion:1,fields:{contentReleaseId:'string',records:'array','records[]':'object','records[].id':'string'}}).records;
const cardImage=(id:string|null)=>{const asset=getAsset(id);return asset?.thumbnailUrl||asset?.previewUrl||null;};
const rarityMap=Object.fromEntries(catalog.cardTaxonomy.rarities.map(r=>[r.code,r.label]));
const bandMasterMap=Object.fromEntries(catalog.bands.map(b=>[b.id,String(b.masterId)]));
const characterBandMasterMap=Object.fromEntries(catalog.characters.filter(c=>c.bandId&&bandMasterMap[c.bandId]).map(c=>[c.id,bandMasterMap[c.bandId]]));
const cardBandIds=(c:MemberCard|SupportCard)=>{const cids='featuredCharacterIds' in c?c.featuredCharacterIds:[c.characterId];return [...new Set((cids??[]).map(id=>characterBandMasterMap[id]).filter(Boolean))];};
const cardVisual=(c:MemberCard|SupportCard)=>({id:String(c.masterId),name:c.displayName,image:cardImage(c.thumbnailAssetId),href:c.id,attribute:c.attributeCode,rarity:c.rarity,rarityLabel:rarityMap[c.rarity]??'',bandIds:cardBandIds(c)});
const visuals=JSON.stringify({band:filterVisualOptions.band.map(b=>({...b,circleIcon:bandCircleIcon(b.value).icon??null,color:catalog.bands.find(v=>String(v.masterId)===b.value)?.mainColor})),attribute:filterVisualOptions.attribute,
 items:itemIndex.map(i=>({id:String(i.masterId),icon:getAsset(i.iconAssetId)?.previewUrl??null})),
 members:catalog.memberCards.map(cardVisual),supports:catalog.supportCards.map(cardVisual),
 songs:catalog.musicTracks.map(s=>({id:String(s.masterId),title:s.title,attribute:s.musicType,missions:s.gekisouMissions.map(m=>m.typeCode),image:getAsset(s.jacketAssetId)?.previewUrl??null,bandIds:s.bandIds.map(id=>String(catalog.bands.find(b=>b.id===id)?.masterId??id))}))}).replaceAll('<','\\u003c');
---
<section class="arena tool-design-tokens content-shell" data-arena-root data-handoff={String(handoff)} data-locale={activeReleaseContext.locale} aria-busy="true">
 <p class="arena-meta" data-arena-meta></p>
 <p class="arena-feedback" data-arena-feedback role="status" aria-live="polite"></p>
 <div data-arena-body><div class="arena-loading" role="status"><p>{en?'Loading stage conditions…':'正在读取舞台条件…'}</p><div class="arena-segments" aria-hidden="true"><span></span><span></span><span></span></div></div></div>

 <dialog class="arena-dialog ui-dialog arena-reference-dialog" data-arena-reference-dialog aria-labelledby="arena-reference-title"><header class="arena-dialog-bar"><h2 id="arena-reference-title" data-arena-reference-title></h2><button type="button" class="ui-icon-btn ui-icon-btn--circle" data-action="reference-close" aria-label={en?'Close information':'关闭说明'} title={en?'Close':'关闭'}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4 12 12M12 4 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button></header><div data-arena-reference-body></div></dialog>
 <dialog class="arena-dialog ui-dialog arena-personal-dialog" data-arena-personal-dialog aria-labelledby="arena-personal-title"><header class="arena-dialog-bar"><h2 id="arena-personal-title">{en?'My arena rank':'我的舞台排名'}</h2><button type="button" class="ui-icon-btn ui-icon-btn--circle" data-personal-close aria-label={en?'Close':'关闭'} title={en?'Close':'关闭'}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4 12 12M12 4 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button></header><div data-arena-personal-body></div></dialog>
 <noscript>{en?'Enable JavaScript to query conditions. Teams are locked after song selection.':'启用 JavaScript 后可查询舞台条件。抽歌后锁队。'}</noscript>
 <script type="application/json" data-arena-visuals set:html={visuals}></script>
</section>
<script>import {installArenaPage} from '../lib/arena-ui.mjs';
 for(const root of document.querySelectorAll('[data-arena-root]')) installArenaPage(root);
</script>
