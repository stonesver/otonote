---
import formalRules from '../data/formal-scoring-rules.json';
import { referenceScoringRules } from '../lib/scoring-release-gate.mjs';
import { activeReleaseContext } from '../lib/release-context';
const english = activeReleaseContext.locale === 'en';
---
{referenceScoringRules(formalRules) && <aside class="tool-capability" data-scoring-reference>
  <strong>{english ? 'Reference estimate' : '参考估算'}</strong>
  <p>{english
    ? 'Uses current cards and charts with the scoring model. Perfect play and skill order assumptions make results estimates.'
    : '使用当前卡牌与谱面数据，按计分模型估算；实际分数会受判定与技能顺序影响。'}</p>
</aside>}
<style>
  [data-scoring-reference] { margin: 0 0 1rem; padding: .8rem 1rem; border: 1px solid var(--theme-border); border-radius: .75rem; background: var(--theme-surface-deep); color: var(--theme-muted); font-size: .85rem; }
  [data-scoring-reference] p { margin: .25rem 0 0; line-height: 1.6; }
</style>
